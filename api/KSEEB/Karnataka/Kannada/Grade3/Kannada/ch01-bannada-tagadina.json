  "schemaVersion": "1.0",
  "segments": [
    {
      "id": "competency",
      "text": "ಪಠ್ಯವನ್ನು ಓದಿದ ಮೇಲೆ ಯಾರು? ಯಾವಾಗ? ಎಲ್ಲಿ? ಏನು? ಏಕೆ? ಎಂಬ ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರಿಸುವುದು.",
      "translations": {
        "en": "After reading the text, to answer the questions — Who? When? Where? What? Why?",
        "hi": "पाठ पढ़ने के बाद कौन? कब? कहाँ? क्या? क्यों? इन प्रश्नों के उत्तर देना."
      },
      "transliterations": {
        "devanagari": "पठ्यवन्नु ओदिद मेले यारु? यावाग? एल्लि? एनु? एके? एंब प्रश्नेगळिगे उत्तरिसुवुदु.",
        "latin": "Pathyavannu oodida mele yaaru? Yaavaaga? Elli? Enu? Eke? Emba prashnegalige uttarisuvudu."
      },
      "type": "competency"
    },
    {
      "id": "intro-1",
      "section": "intro",
      "text": "ಸಂತೋಷ, ದುಃಖ, ನೋವು — ಈ ಅನುಭವಗಳು ನಿನಗೂ ಆಗಿರಬಹುದಲ್ಲವೇ?",
      "translations": {
        "en": "Joy, sorrow, pain — haven't these experiences happened to you too?",
        "hi": "खुशी, दुःख, दर्द — ये अनुभव तुम्हें भी हुए होंगे, है ना?"
      },
      "transliterations": {
        "devanagari": "सन्तोष, दुःख, नोवु — ई अनुभवगळु निनगू आगिरबहुदल्लवे?",
        "latin": "Santosha, duhkha, novu — ee anubhavagalu ninagoo aagirabahudallave?"
      },
      "type": "prose"
    },
    {
      "id": "intro-2",
      "section": "intro",
      "text": "ನಿನ್ನ ಒಂದು ಅನುಭವವನ್ನು ನೆನೆಪಿಸಿಕೊ.",
      "translations": {
        "en": "Recall one experience of your own.",
        "hi": "अपने एक अनुभव को याद करो."
      },
      "transliterations": {
        "devanagari": "निन्न ओन्दु अनुभववन्नु नेनेपिसिको.",
        "latin": "Ninna ondu anubhavavannu nenepisiko."
      },
      "type": "prose"
    },
    {
      "id": "intro-3",
      "section": "intro",
      "text": "ಅದಕ್ಕೆ ಒಂದು ಕಾರಣವೂ ಇರಬೇಕಲ್ಲವೇ?",
      "translations": {
        "en": "There must be a reason for it, mustn't there?",
        "hi": "उसके पीछे कोई कारण भी होगा, है ना?"
      },
      "transliterations": {
        "devanagari": "अदक्के ओन्दु कारणवू इरबेकल्लवे?",
        "latin": "Adakke ondu kaaranavoo irabekallave?"
      },
      "type": "prose"
    },
    {
      "id": "intro-4",
      "section": "intro",
      "text": "ಈಗ ಇಲ್ಲಿನ ಘಟನೆಯನ್ನು ಗಮನಿಸು.",
      "translations": {
        "en": "Now observe the incident described here.",
        "hi": "अब यहाँ दी गई घटना को ध्यान से देखो."
      },
      "transliterations": {
        "devanagari": "ईग इल्लिन घटनेयन्नु गमनिसु.",
        "latin": "Eega illina ghataneyannu gamanisu."
      },
      "type": "prose"
    },
    {
      "id": "intro-5",
      "section": "intro",
      "text": "ಸಂತೋಷ ಹಾಗೂ ದುಃಖಕ್ಕೆ ಕಾರಣವಾದ ಸಂದರ್ಭಗಳನ್ನು ಗುರುತಿಸು.",
      "translations": {
        "en": "Identify the situations that caused happiness and sadness.",
        "hi": "खुशी और दुःख का कारण बनी परिस्थितियों को पहचानो."
      },
      "transliterations": {
        "devanagari": "सन्तोष हागू दुःखक्के कारणवाद सन्दर्भगळन्नु गुरुतिसु.",
        "latin": "Santosha haagoo duhkhakke kaaranavaada sandarbhagalannu gurutisu."
      },
      "type": "prose"
    },
    {
      "id": "poem-s1l1",
      "stanza": 1,
      "text": "ಬಣ್ಣದ ತಗಡಿನ ತುತ್ತೂರಿ",
      "translations": {
        "en": "The colorful tin trumpet,",
        "hi": "रंग-बिरंगी टीन की तुरही,"
      },
      "transliterations": {
        "devanagari": "बण्णद तगडिन तुत्तूरि",
        "latin": "Bannada tagadina tutturi"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "stanza": 1,
      "text": "ಕಾಸಿಗೆ ಕೊಂಡನು ಕಸ್ತೂರಿ",
      "translations": {
        "en": "Kasturi bought it for a coin.",
        "hi": "कस्तूरी ने एक सिक्के में खरीदी।"
      },
      "transliterations": {
        "devanagari": "कासिगे कोण्डनु कस्तूरि",
        "latin": "Kaasige kondanu Kasturi"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l3",
      "stanza": 1,
      "text": "ಸರಿಗಮಪದನಿಸ ಊದಿದನು",
      "translations": {
        "en": "He blew Sa-Ri-Ga-Ma-Pa-Da-Ni-Sa (ascending notes).",
        "hi": "उसने सा-रि-ग-म-प-द-नि-सा (आरोही स्वर) बजाई,"
      },
      "transliterations": {
        "devanagari": "सरिगमपदनिस ऊदिदनु",
        "latin": "Sarigamapadanisa oodidanu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l4",
      "stanza": 1,
      "text": "ಸನಿದಪ ಮಗರಿಸ ಊದಿದನು",
      "translations": {
        "en": "He blew Sa-Ni-Da-Pa-Ma-Ga-Ri-Sa (descending notes).",
        "hi": "उसने सा-नि-द-प-म-ग-रि-सा (अवरोही स्वर) बजाई।"
      },
      "transliterations": {
        "devanagari": "सनिदप मगरिस ऊदिदनु",
        "latin": "Sanidapa magarisa oodidanu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "stanza": 2,
      "text": "ತನಗೇ ತುತ್ತೂರಿ ಇದೆಯೆಂದ",
      "translations": {
        "en": "He boasted that only he has the trumpet,",
        "hi": "उसने घमंड से कहा कि तुरही सिर्फ़ उसी के पास है,"
      },
      "transliterations": {
        "devanagari": "तनगे तुत्तूरि इदेयेन्द",
        "latin": "Tanagee tutturi ideyenda"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "stanza": 2,
      "text": "ಬೇರಾರಿಗು ಅದು ಇಲ್ಲೆಂದ",
      "translations": {
        "en": "He said no one else has one.",
        "hi": "और किसी के पास नहीं है, ऐसा कहा।"
      },
      "transliterations": {
        "devanagari": "बेरारिगू अदु इल्लेन्द",
        "latin": "Beraarigu adu illenda"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l3",
      "stanza": 2,
      "text": "ಕಸ್ತೂರಿ ನಡೆದನು ಬೀದಿಯಲಿ",
      "translations": {
        "en": "Kasturi strutted down the street,",
        "hi": "कस्तूरी गली में इतराते हुए चला,"
      },
      "transliterations": {
        "devanagari": "कस्तूरि नडेदनु बीदियलि",
        "latin": "Kasturi nadedanu biidiyali"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l4",
      "stanza": 2,
      "text": "ಜಂಭದ ಕೋಳಿಯ ರೀತಿಯಲಿ",
      "translations": {
        "en": "Like a proud, arrogant rooster.",
        "hi": "घमंडी मुर्गे की तरह।"
      },
      "transliterations": {
        "devanagari": "जंभद कोळिय रीतियलि",
        "latin": "Jambhada koliya riitiyali"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "stanza": 3,
      "text": "ತುತ್ತೂರಿಯೂದುತ ಕೊಳದ ಬಳಿ",
      "translations": {
        "en": "Blowing his trumpet near the pond,",
        "hi": "तालाब के पास तुरही बजाते हुए,"
      },
      "transliterations": {
        "devanagari": "तुत्तूरियूदुत कोळद बळि",
        "latin": "Tutturiyooduta kolada bali"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "stanza": 3,
      "text": "ನಡೆದನು ಕಸ್ತೂರಿ ಸಂಜೆಯಲಿ",
      "translations": {
        "en": "Kasturi walked in the evening.",
        "hi": "कस्तूरी शाम को चला।"
      },
      "transliterations": {
        "devanagari": "नडेदनु कस्तूरि संजेयलि",
        "latin": "Nadedanu Kasturi sanjeyali"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l3",
      "stanza": 3,
      "text": "ಜಾರಿತು ನೀರಿಗೆ ತುತ್ತೂರಿ",
      "translations": {
        "en": "The trumpet slipped into the water.",
        "hi": "तुरही पानी में फिसल गई,"
      },
      "transliterations": {
        "devanagari": "जारितु नीरिगे तुत्तूरि",
        "latin": "Jaaritu neerige tutturi"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l4",
      "stanza": 3,
      "text": "ಗಂಟಲು ಕಟ್ಟಿತು ನೀರೂರಿ",
      "translations": {
        "en": "His throat choked, tears welled in his eyes.",
        "hi": "उसका गला रुँध गया, आँखों में पानी भर आया।"
      },
      "transliterations": {
        "devanagari": "गंटलु कट्टितु नीरूरि",
        "latin": "Gantalu kattitu neeroori"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l1",
      "stanza": 4,
      "text": "ಸರಿಗಮ ಊದಲು ನೋಡಿದನು",
      "translations": {
        "en": "He tried to blow Sa-Ri-Ga-Ma again,",
        "hi": "उसने फिर से सा-रि-ग-म बजाने की कोशिश की,"
      },
      "transliterations": {
        "devanagari": "सरिगम ऊदलु नोडिदनु",
        "latin": "Sarigama oodalu nodidanu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l2",
      "stanza": 4,
      "text": "ಗಗಗಗ ಸದ್ದನು ಮಾಡಿದನು",
      "translations": {
        "en": "It only made a ga-ga-ga-ga gurgling sound.",
        "hi": "पर सिर्फ़ ग-ग-ग-ग जैसी गड़गड़ाहट की आवाज़ आई।"
      },
      "transliterations": {
        "devanagari": "ग-ग-ग-ग सद्दनु माडिदनु",
        "latin": "Gagagaga saddanu maadidanu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l3",
      "stanza": 4,
      "text": "ಬಣ್ಣವು ನೀರಿನ ಪಾಲಾಯ್ತು",
      "translations": {
        "en": "The paint washed off into the water,",
        "hi": "रंग पानी में धुल गया,"
      },
      "transliterations": {
        "devanagari": "बण्णवु नीरिन पालायतु",
        "latin": "Bannavu neerina paalaaytu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l4",
      "stanza": 4,
      "text": "ಬಣ್ಣದ ತುತ್ತೂರಿ ಬೋಳಾಯ್ತು",
      "translations": {
        "en": "The colorful trumpet was stripped bare.",
        "hi": "रंग-बिरंगी तुरही बेरंग हो गई।"
      },
      "transliterations": {
        "devanagari": "बण्णद तुत्तूरि बोळायतु",
        "latin": "Bannada tutturi bolaaytu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l1",
      "stanza": 5,
      "text": "ಬಣ್ಣದ ತುತ್ತೂರಿ ಹಾಳಾಯ್ತು",
      "translations": {
        "en": "The colorful trumpet was ruined,",
        "hi": "रंग-बिरंगी तुरही बर्बाद हो गई,"
      },
      "transliterations": {
        "devanagari": "बण्णद तुत्तूरि हाळायतु",
        "latin": "Bannada tutturi haalaaytu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l2",
      "stanza": 5,
      "text": "ಜಂಭದ ಕೋಳಿಗೆ ಗೋಳಾಯ್ತು",
      "translations": {
        "en": "The arrogant rooster was left in grief.",
        "hi": "घमंडी मुर्गे को दुःख हुआ।"
      },
      "transliterations": {
        "devanagari": "जंभद कोळिगे गोळायतु",
        "latin": "Jambhada kolige golaaytu"
      },
      "type": "poem_line"
    },
    {
      "id": "vocab-kaasu",
      "text": "ಕಾಸು",
      "translations": {
        "en": "coin / money",
        "hi": "सिक्का / पैसा"
      },
      "transliterations": {
        "devanagari": "कासु",
        "latin": "Kaasu"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "vocab-kaasu-def",
      "ref": "vocab-kaasu",
      "text": "ಹಣ",
      "translations": {
        "en": "money",
        "hi": "पैसा"
      },
      "transliterations": {
        "devanagari": "हण",
        "latin": "Hana"
      },
      "type": "vocabulary_definition"
    },
    {
      "id": "vocab-jambha",
      "text": "ಜಂಭ",
      "translations": {
        "en": "pride / arrogance",
        "hi": "घमंड / अहंकार"
      },
      "transliterations": {
        "devanagari": "जंभ",
        "latin": "Jambha"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "vocab-jambha-def",
      "ref": "vocab-jambha",
      "text": "ಅಹಂಕಾರ",
      "translations": {
        "en": "arrogance",
        "hi": "अहंकार"
      },
      "transliterations": {
        "devanagari": "अहंकार",
        "latin": "Ahankaara"
      },
      "type": "vocabulary_definition"
    },
    {
      "id": "vocab-halaagu",
      "text": "ಹಾಳಾಗು",
      "translations": {
        "en": "to be ruined / spoiled",
        "hi": "बर्बाद होना / खराब होना"
      },
      "transliterations": {
        "devanagari": "हाळागु",
        "latin": "Haalaagu"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "vocab-halaagu-def",
      "ref": "vocab-halaagu",
      "text": "ಕೆಟ್ಟುಹೋಗು",
      "translations": {
        "en": "to go bad / be spoiled",
        "hi": "खराब होना"
      },
      "transliterations": {
        "devanagari": "केट्टुहोगु",
        "latin": "Kettuhogu"
      },
      "type": "vocabulary_definition"
    },
    {
      "id": "vocab-saddu",
      "text": "ಸದ್ದು",
      "translations": {
        "en": "sound / noise",
        "hi": "आवाज़ / शोर"
      },
      "transliterations": {
        "devanagari": "सद्दु",
        "latin": "Saddu"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "vocab-saddu-def",
      "ref": "vocab-saddu",
      "text": "ಸಪ್ಪಳ",
      "translations": {
        "en": "noise",
        "hi": "शोर"
      },
      "transliterations": {
        "devanagari": "सप्पळ",
