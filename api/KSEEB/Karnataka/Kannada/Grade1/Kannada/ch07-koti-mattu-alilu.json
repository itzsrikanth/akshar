  "segments": [
    {
      "id": "intro-1",
      "section": "intro",
      "text": "ಅ) ಚಿತ್ರಗಳನ್ನು ತೋರಿಸಿ, ಪಕ್ಕದಲ್ಲಿರುವ ಪ್ರಶ್ನೆಗಳನ್ನು ಕೇಳಿ, ಮಕ್ಕಳಿಂದ ಉತ್ತರ ಪಡೆಯಿರಿ.",
      "translations": {
        "en": "A) Show the pictures, ask the questions beside them, and get answers from the children.",
        "hi": "अ) चित्र दिखाकर पास के प्रश्न पूछें, बच्चों से उत्तर लें।"
      },
      "transliterations": {
        "devanagari": "अ) चित्रगळन्नु तोरिसि, पक्कदल्लिरुव प्रश्नॆगळन्नु केळि, मक्कळिंद उत्तर पडॆयिरि.",
        "latin": "a) citragaḻannu torisi, pakkadalliruva praśnègaḻannu keḻi, makkaḻiṃda uttara paḍèyiri."
      },
      "type": "prose"
    },
    {
      "id": "intro-q1",
      "section": "intro",
      "text": "ಈ ಪ್ರಾಣಿಯ ಹೆಸರೇನು?",
      "translations": {
        "en": "What is the name of this animal?",
        "hi": "इस जानवर का नाम क्या है?"
      },
      "transliterations": {
        "devanagari": "ई प्राणिय हॆसरेनु?",
        "latin": "ī prāṇiya hèsarenu?"
      },
      "type": "question"
    },
    {
      "id": "intro-q2",
      "section": "intro",
      "text": "ಈ ಪ್ರಾಣಿಯ ಹೆಸರೇನು?",
      "translations": {
        "en": "What is the name of this animal?",
        "hi": "इस जानवर का नाम क्या है?"
      },
      "transliterations": {
        "devanagari": "ई प्राणिय हॆसरेनु?",
        "latin": "ī prāṇiya hèsarenu?"
      },
      "type": "question"
    },
    {
      "id": "intro-q3",
      "section": "intro",
      "text": "ಈ ಚಿತ್ರದಲ್ಲಿರುವುದೇನು?",
      "translations": {
        "en": "What is in this picture?",
        "hi": "इस चित्र में क्या है?"
      },
      "transliterations": {
        "devanagari": "ई चित्रदल्लिरुवुदेनु?",
        "latin": "ī citradalliruvudenu?"
      },
      "type": "question"
    },
    {
      "id": "intro-q4",
      "section": "intro",
      "text": "ಈ ಚಿತ್ರದಲ್ಲಿರುವುದೇನು?",
      "translations": {
        "en": "What is in this picture?",
        "hi": "इस चित्र में क्या है?"
      },
      "transliterations": {
        "devanagari": "ई चित्रदल्लिरुवुदेनु?",
        "latin": "ī citradalliruvudenu?"
      },
      "type": "question"
    },
    {
      "id": "story-intro",
      "section": "story",
      "text": "(ಪಾಠವನ್ನು ಓದಿ ಹೇಳಿ, ಮಕ್ಕಳಿಂದ ಹೇಳಿಸಿ)",
      "translations": {
        "en": "(Read and tell the lesson, and have the children say it)",
        "hi": "(पाठ पढ़कर सुनाएँ, बच्चों से बुलवाएँ)"
      },
      "transliterations": {
        "devanagari": "(पाठवन्नु ओदि हेळि, मक्कळिंद हेळिसि)",
        "latin": "(pāṭhavannu odi heḻi, makkaḻiṃda heḻisi)"
      },
      "type": "prose"
    },
    {
      "id": "story-n1",
      "section": "story",
      "text": "ಒಂದು ಕೋತಿ ಮರದ ಮೇಲೆ ಕುಳಿತಿತ್ತು. ಆ ಕೋತಿಯ ಬಾಲ ತುಂಬಾ ಉದ್ದವಿತ್ತು. ಅದು ನೆಲದವರೆಗೆ ನೇತಾಡುತ್ತಿತ್ತು.",
      "translations": {
        "en": "A monkey was sitting on a tree. That monkey’s tail was very long. It was hanging down to the ground.",
        "hi": "एक बंदर पेड़ पर बैठा था। उस बंदर की पूँछ बहुत लंबी थी। वह ज़मीन तक लटक रही थी।"
      },
      "transliterations": {
        "devanagari": "ऒंदु कोति मरद मेलॆ कुळितित्तु. आ कोतिय बाल तुंबा उद्दवित्तु. अदु नॆलदवरॆगॆ नेताडुत्तित्तु.",
        "latin": "òṃdu koti marada melè kuḻitittu. ā kotiya bāla tuṃbā uddavittu. adu nèladavarègè netāḍuttittu."
      },
      "type": "prose"
    },
    {
      "id": "story-n2",
      "section": "story",
      "text": "ಒಂದು ಅಳಿಲು ಕುಣಿದಾಡುತ್ತಾ ಅಲ್ಲಿಗೆ ಬಂದಿತು. ಅದು ಕೋತಿಯ ಬಾಲ ನೋಡಿತು. “ಈ ಜೋಕಾಲಿ ಎಷ್ಟು ಚಂದ!” ಎಂದು ಯೋಚಿಸಿತು. ಕೋತಿಯ ಬಾಲ ಹಿಡಿದು ಅಳಿಲು ಜೀಕತೊಡಗಿತು.",
      "translations": {
        "en": "A squirrel came there hopping. It saw the monkey’s tail. It thought, “How lovely this swing is!” Holding the monkey’s tail, the squirrel began to swing.",
        "hi": "एक गिलहरी उछलती-कूदती वहाँ आई। उसने बंदर की पूँछ देखी। उसने सोचा, “यह झूला कितना सुंदर है!” बंदर की पूँछ पकड़कर गिलहरी झूलने लगी।"
      },
      "transliterations": {
        "devanagari": "ऒंदु अळिलु कुणिदाडुत्ता अल्लिगॆ बंदितु. अदु कोतिय बाल नोडितु. “ई जोकालि ऎष्टु चंद!” ऎंदु योचिसितु. कोतिय बाल हिडिदु अळिलु जीकतॊडगितु.",
        "latin": "òṃdu aḻilu kuṇidāḍuttā alligè baṃditu. adu kotiya bāla noḍitu. “ī jokāli èṣṭu caṃda!” èṃdu yocisitu. kotiya bāla hiḍidu aḻilu jīkatòḍagitu."
      },
      "type": "prose"
    },
    {
      "id": "story-n3",
      "section": "story",
      "text": "ಕೋತಿಗೆ ಕಚಗುಳಿ ಆಯಿತು. ಅದು ಕೆಳಗೆ ನೋಡಿತು ಮತ್ತು ನಗುತ್ತಾ ಹೇಳಿತು.",
      "translations": {
        "en": "The monkey felt ticklish. It looked down and said laughing,",
        "hi": "बंदर को गुदगुदी आई। उसने नीचे देखा और हँसते हुए कहा,"
      },
      "transliterations": {
        "devanagari": "कोतिगॆ कचगुळि आयितु. अदु कॆळगॆ नोडितु मत्तु नगुत्ता हेळितु.",
        "latin": "kotigè kacaguḻi āyitu. adu kèḻagè noḍitu mattu naguttā heḻitu."
      },
      "type": "prose"
    },
    {
      "id": "story-d1",
      "section": "story",
      "speaker": "ಕೋತಿ",
      "text": "ತಂಗಿ, ಏನು ಮಾಡುತ್ತಿರುವೆ? ನನಗೆ ಕಚಗುಳಿಯಾಗುತ್ತಿದೆ.",
      "translations": {
        "en": "Little sister, what are you doing? I am getting ticklish.",
        "hi": "बहन, क्या कर रही हो? मुझे गुदगुदी हो रही है।"
      },
      "transliterations": {
        "devanagari": "तंगि, एनु माडुत्तिरुवॆ? ननगॆ कचगुळियागुत्तिदॆ.",
        "latin": "taṃgi, enu māḍuttiruvè? nanagè kacaguḻiyāguttidè."
      },
      "type": "dialogue"
    },
    {
      "id": "story-n4",
      "section": "story",
      "text": "ಆಗ ಅಳಿಲಿಗೆ ಗಾಬರಿಯಾಯಿತು.",
      "translations": {
        "en": "Then the squirrel got frightened.",
        "hi": "तब गिलहरी डर गई।"
      },
      "transliterations": {
        "devanagari": "आग अळिलिगॆ गाबरियायितु.",
        "latin": "āga aḻiligè gābariyāyitu."
      },
      "type": "prose"
    },
    {
      "id": "story-d2",
      "section": "story",
      "speaker": "ಅಳಿಲು",
      "text": "ಮಂಗಣ್ಣಾ, ಇದು ನಿನ್ನ ಬಾಲವೇ? ಜೋಕಾಲಿ ಎಂದು ತಿಳಿದು ಜೀಕುತ್ತಿದ್ದೆ. ನನ್ನನ್ನು ಕ್ಷಮಿಸು",
      "translations": {
        "en": "Brother monkey, is this your tail? I thought it was a swing and was swinging. Forgive me",
        "hi": "बंदर भैया, क्या यह तुम्हारी पूँछ है? मैंने झूला समझकर झूल रही थी। मुझे क्षमा करो"
      },
      "transliterations": {
        "devanagari": "मंगण्णा, इदु निन्न बालवे? जोकालि ऎंदु तिळिदु जीकुत्तिद्दॆ. नन्नन्नु क्षमिसु",
        "latin": "maṃgaṇṇā, idu ninna bālave? jokāli èṃdu tiḻidu jīkuttiddè. nannannu kṣamisu"
      },
      "type": "dialogue"
    },
    {
      "id": "story-n5",
      "section": "story",
      "text": "ಬಾಲವನ್ನು ಬಿಟ್ಟಿತು. ಅಳಿಲು ಓಡಿಹೋಗಿ, ಮರದ ಕೊಂಬೆಯನ್ನು ಏರಿತು.",
      "translations": {
        "en": "It let go of the tail. The squirrel ran away and climbed a branch of the tree.",
        "hi": "उसने पूँछ छोड़ दी। गिलहरी भागकर पेड़ की डाल पर चढ़ गई।"
      },
      "transliterations": {
        "devanagari": "बालवन्नु बिट्टितु. अळिलु ओडिहोगि, मरद कॊंबॆयन्नु एरितु.",
        "latin": "bālavannu biṭṭitu. aḻilu oḍihogi, marada kòṃbèyannu eritu."
      },
      "type": "prose"
    },
