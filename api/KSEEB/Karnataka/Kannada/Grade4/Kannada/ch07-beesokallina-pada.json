    {
      "id": "poem-s7l1",
      "section": "poem",
      "stanza": 7,
      "text": "ಜನವಾಣಿ ಬೇರು, ಕವಿವಾಣಿ ಹೂವು.",
      "translations": {
        "en": "People's voice is the root, poet's voice is the flower.",
        "hi": "जनवाणी जड़ है, कविवाणी फूल है।"
      },
      "transliterations": {
        "devanagari": "जनवाणि बेरु, कविवाणि हूवु।",
        "latin": "janavaani beeru, kavivaani hoovu."
      },
      "type": "poem_line"
    },
