  "schemaVersion": "1.0",
  "segments": [
    {
      "id": "intro-1",
      "section": "intro",
      "text": "ಜೋಗುಳ ಹಾಡು, ಗೀಗೀ ಪದ, ಸೋಬಾನೆ ಪದ, ಇವುಗಳಲ್ಲಿ ನಿನಗೆ ಗೊತ್ತಿರುವ ಯಾವುದಾದರೊಂದು ಹಾಡನ್ನು ತರಗತಿಯಲ್ಲಿ ಗೆಳೆಯರೊಡಗೂಡಿ ಹಾಡು.",
      "translations": {
        "en": "Sing a lullaby, gigi song, or sobane song, whichever you know among these, along with your friends in the class.",
        "hi": "लोरी, गीगी गीत, सोबाने गीत, इनमें से जो भी गीत आपको आता हो, उसे कक्षा में अपने दोस्तों के साथ मिलकर गाएं।"
      },
      "transliterations": {
        "devanagari": "जोगुळ हाडु, गीगी पद, सोबाने पद, इवुगळल्लि निनगे गोत्तिरुव यावुदादरोंदु हाडन्नु तरगतियल्लि गेळेयरोडगूडि हाडु।",
        "latin": "jogula haadu, geegi pada, sobane pada, ivugalalli ninage gottiruva yavudadarondu haadannu taragatiyalli geleyarodagoodi haadu."
      },
      "type": "prose"
    },
    {
      "id": "poem-s1l1",
      "section": "poem",
      "stanza": 1,
      "text": "ಕಲ್ಲಮ್ಮ ತಾಯಿ ಮೆಲ್ಲಮ್ಮ ರಾಗಿಯ",
      "translations": {
        "en": "Mother stone, gentle mother, let the ragi",
        "hi": "पत्थर माँ, कोमल माँ, रागी को"
      },
      "transliterations": {
        "devanagari": "कल्लम्म तायि मेल्लम्म रागिय",
        "latin": "kallamma taayi mellamma ragiya"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "section": "poem",
      "stanza": 1,
      "text": "ಜಲ್ಲಜಲ್ಲಾನೆ ಉದುರಮ್ಮ | ನಾ ನಿನಗೆ",
      "translations": {
        "en": "shower down jhalla-jhallane | I will",
        "hi": "झमाझम गिरने दो | मैं तुम्हारी"
      },
      "transliterations": {
        "devanagari": "झल्लझल्लाने उदुरम्म | ना निनगे",
        "latin": "jhallajhallane uduramma | naa ninage"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l3",
      "section": "poem",
      "stanza": 1,
      "text": "ಬೆಲ್ಲಾದಾರತಿಯಾ ಬೆಳಗೇನು ||",
      "translations": {
        "en": "wave a jaggery aarti to you ||",
        "hi": "गुड़ की आरती उतारूंगी ||"
      },
      "transliterations": {
        "devanagari": "बेल्लादारतिया बेळगेनु ||",
        "latin": "belladaaratiya belagenu ||"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "section": "poem",
      "stanza": 2,
      "text": "ಅಂದುಳ್ಳ ಅಡಿಗಲ್ಲು ಚಂದುಳ್ಳ ಮೇಗಲ್ಲು",
      "translations": {
        "en": "Beautiful base stone and beautiful top stone",
        "hi": "सुंदर नीचे का पत्थर और सुंदर ऊपर का पत्थर"
      },
      "transliterations": {
        "devanagari": "अंदुळ्ळ अडिगल्लु चंदुळ्ळ मेगल्लु",
        "latin": "andulla adigallu chandulla meegallu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "section": "poem",
      "stanza": 2,
      "text": "ಚಂದ್ರಮತಿಯೆಂಬ ಹಿಡಿಗೂಟ | ಹಿಡುಕೊಂಡು",
      "translations": {
        "en": "Holding the handle peg called Chandramati |",
        "hi": "चंद्रमती नामक मुठिया को | पकड़कर"
      },
      "transliterations": {
        "devanagari": "चंद्रमतियेंब हिडिगूट | हिडुकोंडु",
        "latin": "chandramatiyemba hidigoota | hidukondu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l3",
      "section": "poem",
      "stanza": 2,
      "text": "ತಂದೆ ತಾಯಿಗಳ ನೆನೆದೇನ ||",
      "translations": {
        "en": "I shall remember my parents ||",
        "hi": "मैं अपने माता-पिता को याद करूंगी ||"
      },
      "transliterations": {
        "devanagari": "तंदे तायिगळ नेनेदेन ||",
        "latin": "tande taayigala nenedena ||"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "section": "poem",
      "stanza": 3,
      "text": "ರಾಗಿಯು ಮುಗಿದಾವು ರಾಜಾನ್ನ ಹೆಚ್ಚ್ಯಾವು",
      "translations": {
        "en": "The ragi will get over, the fragrant rice will increase",
        "hi": "रागी खत्म हो जाएगी, सुगंधित चावल बढ़ेंगे"
      },
      "transliterations": {
        "devanagari": "रागियु मुगिदावु राजान्न हेच्च्यावु",
        "latin": "raagiyu mugidaavu raajanna heccyaavu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "section": "poem",
      "stanza": 3,
      "text": "ನಾನ್ಹಿಡಿದ ಕೆಲಸ ವದಗ್ಯಾವು | ರಾಗೀಕಲ್ಲೆ",
      "translations": {
        "en": "The work I have taken up will be done | Ragi stone,",
        "hi": "मेरे द्वारा लिया गया काम पूरा हो जाएगा | रागी के पत्थर,"
      },
      "transliterations": {
        "devanagari": "नान्हिडिद केलस वदग्यावु | रागीकल्ले",
        "latin": "naanhidida kelasa vadagyaavu | raagikalle"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l3",
      "section": "poem",
      "stanza": 3,
      "text": "ನಾ ತೂಗಿ ಬಿಡುತೀನಿ ಬಲದೋಳು ||",
      "translations": {
        "en": "I will swing and release you with my right arm ||",
        "hi": "मैं तुम्हें अपने दाहिने हाथ से झुलाकर छोड़ूंगी ||"
      },
      "transliterations": {
        "devanagari": "ना तूगि बिडुतीनि बलदोळु ||",
        "latin": "naa toogi biduteeni baladolu ||"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l1",
      "section": "poem",
      "stanza": 4,
      "text": "ಕಲ್ಲು ಬಿಟ್ಟೇನೆಂದು ಸಿಟ್ಯಾಕೆ ಸರಸತಿಯೇ",
      "translations": {
        "en": "Why are you angry, Saraswati, thinking I left the stone?",
        "hi": "पत्थर छोड़ दिया, ऐसा सोचकर क्यों गुस्सा हो सरस्वती"
      },
      "transliterations": {
        "devanagari": "कल्लु बिट्टेनेंदु सिट्याके सरसतिये",
        "latin": "kallu bittenedu sittyake sarasatiye"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l2",
      "section": "poem",
      "stanza": 4,
      "text": "ಕುಕ್ಕೇಲಿ ರಾಗಿ ಬೆಳೆಯಾಲಿ | ತಕ್ಕೊಂಡು",
      "translations": {
        "en": "Let the ragi grow in the basket | I will take it",
        "hi": "टोकरी में रागी बढ़ने दो | लेकर"
      },
      "transliterations": {
        "devanagari": "कुक्केलि रागि बेळेयालि | तक्कोंडु",
        "latin": "kukkeli ragi beleyali | takkondu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l3",
      "section": "poem",
      "stanza": 4,
      "text": "ಮತ್ತೆ ರಾತ್ರೀಗೆ ಬರುತೀನಿ ||",
      "translations": {
        "en": "and come back again at night ||",
        "hi": "मैं फिर रात को आऊंगी ||"
      },
      "transliterations": {
        "devanagari": "मत्ते रात्रीगे बरुतीनि ||",
        "latin": "matte raatrige baruteeni ||"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l1",
      "section": "poem",
      "stanza": 5,
      "text": "ಕಲ್ಲು ಕೊಟ್ಟಮ್ಮಗೆ ಎಲ್ಲಾ ಭಾಗ್ಯವು ಬರಲಿ",
      "translations": {
        "en": "Let all fortunes come to the mother who gave the stone",
        "hi": "पत्थर देने वाली माँ को सारा सौभाग्य मिले"
      },
      "transliterations": {
        "devanagari": "कल्लु कोट्टम्मगे एल्ला भाग्यवु बरलि",
        "latin": "kallu kottammage ella bhagyavu barali"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l2",
      "section": "poem",
      "stanza": 5,
      "text": "ಪಲ್ಲಕ್ಕಿ ಮೇಲೆ ಮಗ ಬರಲಿ | ಆ ಮನೆಗೆ",
      "translations": {
        "en": "Let a son come on a palanquin | To that house,",
        "hi": "बेटा पालकी पर आए | उस घर में"
      },
      "transliterations": {
        "devanagari": "पल्लक्कि मेले मग बरलि | आ मनेगे",
        "latin": "pallakki mele maga barali | aa manege"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l3",
      "section": "poem",
      "stanza": 5,
      "text": "ಮಲ್ಲಿಗೆ ಮುಡಿಯೋ ಸೊಸಿ ಬರಲಿ ||",
      "translations": {
        "en": "let a daughter-in-lock wearing jasmine come ||",
        "hi": "चमेली पहनने वाली बहू आए ||"
      },
      "transliterations": {
