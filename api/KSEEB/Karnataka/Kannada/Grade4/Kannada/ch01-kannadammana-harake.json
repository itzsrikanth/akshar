  "segments": [
    {
      "id": "intro-1",
      "section": "intro",
      "text": "ಕನ್ನಡ ನಾಡಿನ ಬಗ್ಗೆ ನಿಮಗೆ ತಿಳಿದಿರುವ ಒಂದು ಹಾಡನ್ನು ತರಗತಿಯಲ್ಲಿ ರಾಗವಾಗಿ ಹಾಡಿರಿ.",
      "translations": {
        "en": "Sing a song you know about the land of Kannada to a tune in class.",
        "hi": "कन्नड़ प्रदेश के बारे में तुम्हें जो गीत आता है, उसे कक्षा में सुर में गाओ।"
      },
      "transliterations": {
        "devanagari": "कन्नड नाडिन बग्गे निमगे तिळिदिरुव ओंदु हाडन्नु तरगतियल्लि रागवागि हाडिरि.",
        "latin": "Kannada naadina bagge nimage tilidiruva ondu haadannu taragatiyalli raagavaagi haadiri."
      },
      "type": "prose"
    },
    {
      "id": "poem-s1l1",
      "stanza": 1,
      "text": "ಕನ್ನಡಕೆ ಹೋರಾಡು",
      "translations": {
        "en": "Strive for Kannada,",
        "hi": "कन्नड़ के लिए संघर्ष करो,"
      },
      "transliterations": {
        "devanagari": "कन्नडके होराडु",
        "latin": "Kannadake horaadu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "stanza": 1,
      "text": "ಕನ್ನಡದ ಕಂದಾ;",
      "translations": {
        "en": "O child of Kannada;",
        "hi": "कन्नड़ के प्यारे बच्चे;"
      },
      "transliterations": {
        "devanagari": "कन्नडद कंदा;",
        "latin": "Kannadada kandaa;"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l3",
      "stanza": 1,
      "text": "ಕನ್ನಡವ ಕಾಪಾಡು",
      "translations": {
        "en": "Protect Kannada,",
        "hi": "कन्नड़ की रक्षा करो,"
      },
      "transliterations": {
        "devanagari": "कन्नडव कापाडु",
        "latin": "Kannadava kaapaadu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l4",
      "stanza": 1,
      "text": "ನನ್ನ ಆನಂದಾ |",
      "translations": {
        "en": "You who are my joy.",
        "hi": "मेरे आनंद, मेरे लाल।"
      },
      "transliterations": {
        "devanagari": "नन्न आनंदा |",
        "latin": "Nanna aanandaa |"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "stanza": 2,
      "text": "ಜೋಗುಳದ ಹರಕೆಯಿದು",
      "translations": {
        "en": "This is a blessing in a lullaby;",
        "hi": "यह लोरी में दिया आशीर्वाद है,"
      },
      "transliterations": {
        "devanagari": "जोगुळद हरकेयिदु",
        "latin": "Jogulada harakeyidu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "stanza": 2,
      "text": "ಮರೆಯದಿರು, ಚಿನ್ನಾ;",
      "translations": {
        "en": "Do not forget it, my precious child.",
        "hi": "इसे मत भूलना, मेरे प्यारे;"
      },
      "transliterations": {
        "devanagari": "मरेयदिरु, चिन्ना;",
        "latin": "Mareyadiru, chinnaa;"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l3",
      "stanza": 2,
      "text": "ಮರೆತೆಯಾದರೆ ಅಯ್ಯೊ",
      "translations": {
        "en": "If you forget it, alas,",
        "hi": "अगर भूल गए, तो हाय,"
      },
      "transliterations": {
        "devanagari": "मरेतेयादरे अय्यो",
        "latin": "Mareteyaadare ayyo"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l4",
      "stanza": 2,
      "text": "ಮರೆತಂತೆ ನನ್ನ |",
      "translations": {
        "en": "It is as though you have forgotten me.",
        "hi": "मानो मुझे ही भूल गए।"
      },
      "transliterations": {
        "devanagari": "मरेतंते नन्न |",
        "latin": "Maretante nanna |"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "stanza": 3,
      "text": "ಮೊಲೆಯ ಹಾಲೆಂತಂತೆ",
      "translations": {
        "en": "Like a mother's milk,",
        "hi": "माँ के दूध की तरह,"
      },
      "transliterations": {
        "devanagari": "मोलेय हालेंतंते",
        "latin": "Moleya haalentante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "stanza": 3,
      "text": "ಸವಿಜೇನು ಬಾಯ್ಗೆ;",
      "translations": {
        "en": "It is sweet honey to the mouth;",
        "hi": "यह मुँह में मीठा शहद है;"
      },
      "transliterations": {
        "devanagari": "सविजेनु बाय्गे;",
        "latin": "Savijenu baayge;"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l3",
      "stanza": 3,
      "text": "ತಾಯಿಯಪ್ಪುಗೆಯಂತೆ",
      "translations": {
        "en": "Like a mother's embrace,",
        "hi": "माँ की बाँहों की तरह,"
      },
      "transliterations": {
        "devanagari": "तायियप्पुगेयंते",
        "latin": "Taayiyappugeyante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l4",
      "stanza": 3,
      "text": "ಬಲುಸೊಗಸು ಮೆಯ್ಗೆ |",
      "translations": {
        "en": "It brings great comfort to the body.",
        "hi": "यह तन को बड़ा सुख देती है।"
      },
      "transliterations": {
        "devanagari": "बलुसोगसु मेय्गे |",
        "latin": "Balusogasu meyge |"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l1",
      "stanza": 4,
      "text": "ಗುರುವಿನೊಳ್ನುಡಿಯಂತೆ",
      "translations": {
        "en": "Like a teacher's good words,",
        "hi": "गुरु के अच्छे वचनों की तरह,"
      },
      "transliterations": {
        "devanagari": "गुरुविनोळ्नुडियंते",
        "latin": "Guruvinolnudiyante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l2",
      "stanza": 4,
      "text": "ಶ್ರೇಯಸ್ಸು ಬಾಳ್ಗೆ;",
      "translations": {
        "en": "It brings well-being to life;",
        "hi": "यह जीवन का कल्याण करती है;"
      },
      "transliterations": {
        "devanagari": "श्रेयस्सु बाळ्गे;",
        "latin": "Shreyassu baalge;"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l3",
      "stanza": 4,
      "text": "ತಾಯ್ನುಡಿಗೆ ದುಡಿದು ಮಡಿ",
      "translations": {
        "en": "Work for your mother tongue till you die,",
        "hi": "जीवन के अंत तक मातृभाषा के लिए काम करो,"
      },
      "transliterations": {
        "devanagari": "ताय्नुडिगे दुडिदु मडि",
        "latin": "Taaynudige dudidu madi"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l4",
      "stanza": 4,
      "text": "ಇಹಪರಗಳೇಳ್ಗೆ |",
      "translations": {
        "en": "For well-being in this world and the next.",
        "hi": "इस लोक और परलोक के कल्याण के लिए।"
      },
      "transliterations": {
        "devanagari": "इहपरगळेळ्गे |",
        "latin": "Ihaparagalelge |"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l1",
      "stanza": 5,
      "text": "ದಮ್ಮಯ್ಯ ಕಂದಯ್ಯ",
      "translations": {
        "en": "I implore you, dear child,",
        "hi": "विनती करती हूँ, मेरे बच्चे,"
      },
      "transliterations": {
        "devanagari": "दम्मय्य कंदय्य",
        "latin": "Dammayya kandayya"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l2",
      "stanza": 5,
      "text": "ಬೇಡುವೆನು ನಿನ್ನ;",
      "translations": {
        "en": "I plead with you;",
        "hi": "तुमसे प्रार्थना करती हूँ;"
      },
      "transliterations": {
        "devanagari": "बेडुवेनु निन्न;",
        "latin": "Beduvenu ninna;"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l3",
      "stanza": 5,
      "text": "ಕನ್ನಡಮ್ಮನ ಹರಕೆ,",
      "translations": {
        "en": "Mother Kannada's blessing—",
        "hi": "कन्नड़ माँ का आशीर्वाद,"
      },
      "transliterations": {
        "devanagari": "कन्नडम्मन हरके,",
        "latin": "Kannadammana harake,"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l4",
      "stanza": 5,
      "text": "ಮರೆಯದಿರು, ಚಿನ್ನಾ |",
      "translations": {
        "en": "Do not forget it, my precious child.",
        "hi": "मत भूलना, मेरे प्यारे।"
      },
      "transliterations": {
        "devanagari": "मरेयदिरु, चिन्ना |",
        "latin": "Mareyadiru, chinnaa |"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l1",
      "stanza": 6,
      "text": "ಮರೆತೆಯಾದರೆ ಅಯ್ಯೊ;",
      "translations": {
        "en": "If you forget it, alas,",
        "hi": "अगर भूल गए, तो हाय,"
      },
      "transliterations": {
        "devanagari": "मरेतेयादरे अय्यो;",
        "latin": "Mareteyaadare ayyo;"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l2",
      "stanza": 6,
      "text": "ಮರೆತಂತೆ ನನ್ನ;",
      "translations": {
        "en": "It is as though you have forgotten me;",
        "hi": "मानो मुझे ही भूल गए;"
      },
