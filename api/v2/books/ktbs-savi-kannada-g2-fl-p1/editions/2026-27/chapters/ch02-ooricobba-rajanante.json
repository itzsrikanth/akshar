  "schemaVersion": "2.0",
  "segments": [
    {
      "id": "poem-s1l1",
      "stanza": 1,
      "text": "ಒಂದಾನೊಂದು ಊರಿತ್ತಂತೆ",
      "translations": {
        "en": "There was once a town, it seems",
        "hi": "एक गाँव था ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "ओन्दानोन्दु ऊरित्तन्ते",
        "latin": "ondānondu ūrittante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "stanza": 1,
      "text": "ಊರಿಗೊಬ್ಬ ರಾಜನಂತೆ",
      "translations": {
        "en": "Like a king for the town, it seems",
        "hi": "गाँव का एक राजा था ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "ऊरिगोब्ब राजनन्ते",
        "latin": "ūrigobba rājanante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l3",
      "stanza": 1,
      "text": "ರಾಜಗೊಬ್ಬ ಮಂತ್ರಿಯಂತೆ",
      "translations": {
        "en": "Like a minister for the king, it seems",
        "hi": "राजा का एक मंत्री था ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "राजगोब्ब मन्त्रियन्ते",
        "latin": "rājagobba mantriyante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l4",
      "stanza": 1,
      "text": "ಮಂತ್ರಿಗೊಬ್ಬ ಮಗಳಂತೆ",
      "translations": {
        "en": "Like a daughter for the minister, it seems",
        "hi": "मंत्री की एक बेटी थी ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "मन्त्रिगोब्ब मगळन्ते",
        "latin": "mantrigobba magaḷante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l5",
      "stanza": 1,
      "text": "ಮಗಳಿಗೊಂದು ಗೊಂಬೆಯಂತೆ",
      "translations": {
        "en": "Like a doll for the daughter, it seems",
        "hi": "बेटी की एक गुड़िया थी ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "मगळिगोन्दु गोम्बेयन्ते",
        "latin": "magaḷigondu gombeyante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "stanza": 2,
      "text": "ಗೊಂಬೆಗೊಂದು ಅಂಗಿಯಂತೆ",
      "translations": {
        "en": "Like a shirt for the doll, it seems",
        "hi": "गुड़िया की एक कमीज़ थी ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "गोम्बेगोन्दु अङ्गियन्ते",
        "latin": "gombegondu aṅgiyante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "stanza": 2,
      "text": "ಅಂಗಿಗೊಂದು ಗುಂಡಿಯಂತೆ",
      "translations": {
        "en": "Like a button for the shirt, it seems",
        "hi": "कमीज़ का एक बटन था ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "अङ्गिगोन्दु गुण्डियन्ते",
        "latin": "aṅgigondu guṇḍiyante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l3",
      "stanza": 2,
      "text": "ಗುಂಡಿ ಕಿತ್ತು ಹೋಯಿತಂತೆ",
      "translations": {
        "en": "The button tore and fell off, it seems",
        "hi": "बटन टूट गया ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "गुण्डि कित्तु होयितन्ते",
        "latin": "guṇḍi kittu hōyitante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l4",
      "stanza": 2,
      "text": "ದರ್ಜಿಯನ್ನು ಕರೆದರಂತೆ",
      "translations": {
        "en": "They called the tailor, it seems",
        "hi": "दर्जी को बुलाया ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "दर्जियन्नु करेदरन्ते",
        "latin": "darjiyannu karedarante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l5",
      "stanza": 2,
      "text": "ದರ್ಜಿ ಬಂದು ನೋಡಿದನಂತೆ",
      "translations": {
        "en": "The tailor came and saw, it seems",
        "hi": "दर्जी ने आकर देखा ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "दर्जि बन्दु नोडिदनन्ते",
        "latin": "darji bandu nōḍidanante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "stanza": 3,
      "text": "ಗುಂಡಿ ಬಲು ಹಳೆಯದಂತೆ",
      "translations": {
        "en": "The button is very old, it seems",
        "hi": "बटन बहुत पुराना था ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "गुण्डि बलु हळयदन्ते",
        "latin": "guṇḍi balu haḷeyadante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "stanza": 3,
      "text": "ಬೇರೆ ಗುಂಡಿ ತಂದನಂತೆ",
      "translations": {
        "en": "He brought another button, it seems",
        "hi": "दूसरा बटन लाया ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "बेरे गुण्डि तन्दनन्ते",
        "latin": "bēre guṇḍi tandanante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l3",
      "stanza": 3,
      "text": "ಅಂಗಿಗಿಟ್ಟು ಹೊಲಿದನಂತೆ",
      "translations": {
        "en": "He put it on the shirt and sewed it, it seems",
        "hi": "कमीज़ पर रखकर सिल दिया ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "अङ्गिगिट्टु होलिदनन्ते",
        "latin": "aṅgigiṭṭu holidanante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l4",
      "stanza": 3,
      "text": "ಅಂಗಿ ಸರಿಯಾಯಿತಂತೆ",
      "translations": {
        "en": "The shirt was fixed, it seems",
        "hi": "कमीज़ ठीक हो गई ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "अङ्गि सरियायितन्ते",
        "latin": "aṅgi sariyāyitante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l5",
      "stanza": 3,
      "text": "ಮಂತ್ರಿ ಮಗಳ ಆಸೆಯಂತೆ",
      "translations": {
        "en": "Like the minister's daughter's wish, it seems",
        "hi": "मंत्री की बेटी की इच्छा के अनुसार ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "मन्त्रि मगळ आसेयन्ते",
        "latin": "mantri magaḷa āseyante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l1",
      "stanza": 4,
      "text": "ಗೊಂಬೆಗಂಗಿ ಹಾಕಿದರಂತೆ",
      "translations": {
        "en": "They put the shirt on the doll, it seems",
        "hi": "गुड़िया को कमीज़ पहनाई ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "गोम्बेगङ्गि हाकिदरन्ते",
        "latin": "gombegaṅgi hākidarante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l2",
      "stanza": 4,
      "text": "ತುಂಬ ಚಂದ ಕಂಡಿತಂತೆ",
      "translations": {
        "en": "It looked very beautiful, it seems",
        "hi": "बहुत सुंदर लग रही थी ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "तुम्ब चन्द कण्डितन्ते",
        "latin": "tumba canda kaṇḍitante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l3",
      "stanza": 4,
      "text": "ಗೊಂಬೆಯಾಟ ಆಡಿದಳಂತೆ",
      "translations": {
        "en": "She played with the doll, it seems",
        "hi": "उसने गुड़िया का खेल खेला ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "गोम्बेयाट आडिदळन्ते",
        "latin": "gombeyāṭa āḍidaḷante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l4",
      "stanza": 4,
      "text": "ಬೇರೆ ಗೊಂಬೆ ತಂದಳಂತೆ",
      "translations": {
        "en": "She brought another doll, it seems",
        "hi": "दूसरी गुड़िया लाई ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "बेरे गोम्बे तन्दळन्ते",
        "latin": "bēre gombe tandaḷante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l5",
      "stanza": 4,
      "text": "ಎರಡಕ್ಕೂ ಮದುವೆಯಂತೆ",
      "translations": {
        "en": "Marriage for both of them, it seems",
        "hi": "दोनों की शादी है ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "एरडक्कू मधुवेयन्ते",
        "latin": "eraḍakkū maduveyante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l1",
      "stanza": 5,
      "text": "ಊರಿನ ರಾಜ ಬರುವನಂತೆ",
      "translations": {
        "en": "The king of the town will come, it seems",
        "hi": "गाँव का राजा आएगा ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "ऊरिन राज बरुवनन्ते",
        "latin": "ūrina rāja baruvanante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l2",
      "stanza": 5,
      "text": "ನಿಂತು ಮದುವೆ ಮಾಡುವನಂತೆ",
      "translations": {
        "en": "He will stand and perform the marriage, it seems",
        "hi": "खड़े होकर शादी कराएगा ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "निन्तु मधुवे माडुवनन्ते",
        "latin": "nintu maduve māḍuvanante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l3",
      "stanza": 5,
      "text": "ನಾನೂ ನೀನೂ ಹೋಗೋಣಂತೆ",
      "translations": {
        "en": "Let's you and I go, it seems",
        "hi": "मैं और तुम जाएँगे ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "नानू नीनू होगोणन्ते",
        "latin": "nānū nīnū hōgōṇante"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l4",
      "stanza": 5,
      "text": "ಮದುವೆ ನೋಡಿ ಬರೋಣಂತೆ",
      "translations": {
        "en": "Let's see the marriage and come back, it seems",
        "hi": "शादी देखकर आएँगे ऐसा कहते हैं"
      },
      "transliterations": {
        "devanagari": "मधुवे नोडि बरोणन्ते",
        "latin": "maduve nōḍi barōṇante"
      },
      "type": "poem_line"
    },
    {
      "id": "vocab-ondanondu",
      "text": "ಒಂದಾನೊಂದು",
      "translations": {
        "en": "once upon a time",
        "hi": "एक समय"
      },
      "transliterations": {
