  "labels": {
    "exercise-A": {
      "devanagari": "अ) कोट्ट सालुगळन्नु ओदि खालि बिट्ट स्थळक्के सरियाद पद बरेयिरि:",
      "en": "A) Read the given lines and write the correct word in the blank space:",
      "hi": "अ) दी गई पंक्तियों को पढ़कर खाली स्थान पर सही शब्द लिखें:",
      "kn": "ಅ) ಕೊಟ್ಟ ಸಾಲುಗಳನ್ನು ಓದಿ ಖಾಲಿ ಬಿಟ್ಟ ಸ್ಥಳಕ್ಕೆ ಸರಿಯಾದ ಪದ ಬರೆಯಿರಿ:",
      "latin": "a) koṭṭa sālugaḷannu ōdi khāli biṭṭa sthaḷakke sariyāda pada bareyiri:"
    },
    "exercise-B": {
      "devanagari": "आ) ई पद्यभागद मुन्दिन सालुगळन्नु हेळिरि:",
      "en": "B) Say the next lines of this poem section:",
      "hi": "आ) इस कविता भाग की अगली पंक्तियाँ बताएँ:",
      "kn": "ಆ) ಈ ಪದ್ಯಭಾಗದ ಮುಂದಿನ ಸಾಲುಗಳನ್ನು ಹೇಳಿರಿ:",
      "latin": "ā) ī padyabhāgada mundina sālugaḷannu hēḷiri:"
    },
    "exercise-C": {
      "devanagari": "इ) 'अ' पट्टियल्लिन पदगळिगे सरियाद पदवन्नु 'आ' पट्टियिन्द आरिसि होन्दिगि बरे:",
      "en": "C) Choose the correct word from list 'B' for the words in list 'A' and match them:",
      "hi": "इ) 'अ' सूची के शब्दों के लिए सही शब्द 'आ' सूची से चुनकर मिलाएँ:",
      "kn": "ಇ) 'ಅ' ಪಟ್ಟಿಯಲ್ಲಿನ ಪದಗಳಿಗೆ ಸರಿಯಾದ ಪದವನ್ನು 'ಆ' ಪಟ್ಟಿಯಿಂದ ಆರಿಸಿ ಹೊಂದಿಸಿ ಬರೆ:",
      "latin": "i) 'a' paṭṭiyallina padagaḷige sariyāda padavannu 'ā' paṭṭiyinda ārisi hondisi bare:"
    },
