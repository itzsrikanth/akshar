  "labels": {
    "exercise-A": {
      "devanagari": "अ) ई प्रश्नेगळिगे ओन्दु वाक्यदल्लि उत्तर हेळि:",
      "en": "A) Answer these questions in one sentence:",
      "hi": "अ) इन प्रश्नों के उत्तर एक वाक्य में दें:",
      "kn": "ಅ) ಈ ಪ್ರಶ್ನೆಗಳಿಗೆ ಒಂದು ವಾಕ್ಯದಲ್ಲಿ ಉತ್ತರ ಹೇಳಿ:",
      "latin": "a) ī praśnegaḷige ondu vākyadalli uttara hēḷi:"
    },
    "exercise-B": {
      "devanagari": "आ) खालि बिट्टिरुव जागगळल्लि सरियाद पद बरेयिरि:",
      "en": "B) Write the correct word in the blank spaces:",
      "hi": "आ) खाली जगहों में सही शब्द लिखें:",
      "kn": "ಆ) ಖಾಲಿ ಬಿಟ್ಟಿರುವ ಜಾಗಗಳಲ್ಲಿ ಸರಿಯಾದ ಪದ ಬರೆಯಿರಿ:",
      "latin": "ā) khāli biṭṭiruva jāgagaḷalli sariyāda pada bareyiri:"
    },
    "exercise-C": {
      "devanagari": "इ) कोट्टिरुव पदगळिगे प्रास पद हेळि बरेयिरि :",
      "en": "C) Say and write rhyming words for the given words:",
      "hi": "इ) दिए गए शब्दों के लिए तुकांत शब्द बताएँ और लिखें:",
      "kn": "ಇ) ಕೊಟ್ಟಿರುವ ಪದಗಳಿಗೆ ಪ್ರಾಸ ಪದ ಹೇಳಿ ಬರೆಯಿರಿ :",
      "latin": "i) koṭṭiruva padagaḷige prāsa pada hēḷi bareyiri :"
    },
