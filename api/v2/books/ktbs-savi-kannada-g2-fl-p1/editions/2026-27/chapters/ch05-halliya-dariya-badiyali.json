  "segments": [
    {
      "id": "poem-s1l1",
      "stanza": 1,
      "text": "ಹಳ್ಳಿಯ ದಾರಿಯ ಬದಿಯಲಿ ಒಂದು",
      "translations": {
        "en": "By the side of the village path, there was a",
        "hi": "गाँव के रास्ते के किनारे एक"
      },
      "transliterations": {
        "devanagari": "हळ्ळिय दारिय बदियलि ओन्दु",
        "latin": "haḷḷiya dāriya badiyali ondu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "stanza": 1,
      "text": "ಮಾವಿನ ಮರವಿತ್ತು",
      "translations": {
        "en": "Mango tree",
        "hi": "आम का पेड़ था"
      },
      "transliterations": {
        "devanagari": "माविन मरवित्तु",
        "latin": "māvina maravittu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l3",
      "stanza": 1,
      "text": "ಹಲವು ಕೊಂಬೆಗಳನು ಚಾಚಿ",
      "translations": {
        "en": "Spreading its many branches",
        "hi": "अपनी कई शाखाएँ फैलाकर"
      },
      "transliterations": {
        "devanagari": "हलवु कोम्बेगळनु चाचि",
        "latin": "halavu kombegaḷanu cāci"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l4",
      "stanza": 1,
      "text": "ತಣ್ಣೆಳಲನು ಹರಡಿತ್ತು",
      "translations": {
        "en": "It spread cool shade",
        "hi": "उसने ठंडी छाया फैलाई थी"
      },
      "transliterations": {
        "devanagari": "तण्णेळलनु हरडित्तु",
        "latin": "taṇṇeḷalanu haraḍittu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "stanza": 2,
      "text": "ಹಕ್ಕಿ ಪಕ್ಷಿಗಳು ಗೂಡನು ಕಟ್ಟಿದೆ",
      "translations": {
        "en": "Birds have built a nest",
        "hi": "पक्षियों ने घोंसला बनाया है"
      },
      "transliterations": {
        "devanagari": "हक्कि पक्षिगळु गूडनु कट्टिदे",
        "latin": "hakki pakṣigaḷu gūḍanu kaṭṭide"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "stanza": 2,
      "text": "ಮರಿಗಳ ಚಿಲಿಪಿಲಿ ಹಾಡಿತ್ತು",
      "translations": {
        "en": "The chicks sang tweet-tweet",
        "hi": "बच्चे चीं-चीं गा रहे थे"
      },
      "transliterations": {
        "devanagari": "मरिगळ चिलिपिलि हाडित्तु",
        "latin": "marigaḷa cilipili hāḍittu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l3",
      "stanza": 2,
      "text": "ಎಲೆಗಳ ಜೊತೆಗೆ ಕಾಯಿ ತೂಗಿ",
      "translations": {
        "en": "Mangoes swaying along with the leaves",
        "hi": "पत्तों के साथ कच्चे आम झूलते हुए"
      },
      "transliterations": {
        "devanagari": "एलेगळ जोतेगे कायि तूगि",
        "latin": "elegaḷa jotege kāyi tūgi"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l4",
      "stanza": 2,
      "text": "ಬಾಯಲಿ ನೀರನು ತಂದಿತ್ತು",
      "translations": {
        "en": "Brought water to the mouth",
        "hi": "मुँह में पानी लाते थे"
      },
      "transliterations": {
        "devanagari": "बायलि नीरनु तन्दित्तु",
        "latin": "bāyali nīranu tandittu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "stanza": 3,
      "text": "ಮಾವಿನ ಮರದಡಿ ಕಮ್ಮಿನ ಪರಿಮಳ",
      "translations": {
        "en": "The sweet fragrance under the mango tree",
        "hi": "आम के पेड़ के नीचे की मीठी महक"
      },
      "transliterations": {
        "devanagari": "माविन मरदडि कम्मिंन परिमळ",
        "latin": "māvina maradaḍi kammina parimaḷa"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "stanza": 3,
      "text": "ಜನರ ಮನವನು ಸೆಳೆದಿತ್ತು",
      "translations": {
        "en": "Attracted people's minds",
        "hi": "लोगों के मन को लुभाती थी"
      },
      "transliterations": {
        "devanagari": "जनर मनवनु सेळेदित्तु",
        "latin": "janara manavanu seḷedittu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l3",
      "stanza": 3,
      "text": "ಮರವೊಂದಾದರು ಉಪಕಾರವು ನೂರು",
      "translations": {
        "en": "Even though it is one tree, it does a hundred favors",
        "hi": "भले ही यह एक पेड़ है, इसके उपकार सौ हैं"
      },
      "transliterations": {
        "devanagari": "मरवोन्दादरु उपकारवु नूरु",
        "latin": "maravondādaru upakāravu nūru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l4",
      "stanza": 3,
      "text": "ಹಿರಿಮೆಯ ತೋರಿತ್ತು",
      "translations": {
        "en": "It showed its greatness",
        "hi": "इसने अपनी महानता दिखाई"
      },
      "transliterations": {
        "devanagari": "हिरिमेय तोरित्तु",
        "latin": "hirimeya tōrittu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l1",
      "stanza": 4,
      "text": "ಶುದ್ಧ ಗಾಳಿ ಮಳೆ ನಂದನವೇ ಇಳೆ",
      "translations": {
        "en": "Pure air, rain, the earth is a garden",
        "hi": "शुद्ध हवा, बारिश, यह धरती ही नंदनवन (स्वर्ग) है"
      },
      "transliterations": {
        "devanagari": "शुद्ध गाळि मळे नन्दनवे इळे",
        "latin": "śuddha gāḷi maḷe nandanavē iḷe"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l2",
      "stanza": 4,
      "text": "ಹೂ ಹಸಿರಿನ ತಾಕತ್ತು",
      "translations": {
        "en": "The power of flowers and greenery",
        "hi": "फूलों और हरियाली की ताकत"
      },
      "transliterations": {
        "devanagari": "हू हसिरिन ताकत्तु",
        "latin": "hū hasirina tākattu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l3",
      "stanza": 4,
      "text": "ಹಸಿರಿದ್ದರೆ ಉಸಿರು ನಿಲ್ಲುವುದು",
      "translations": {
        "en": "If there is greenery, there will be breath",
        "hi": "हरियाली होगी तभी साँस चलेगी"
      },
      "transliterations": {
        "devanagari": "हसिरिद्दरे उसिरु निल्लुवुदु",
        "latin": "hasiriddare usiru nilluvudu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l4",
      "stanza": 4,
      "text": "ತಿಳಿದುಕೊ ಈ ಹೊತ್ತು",
      "translations": {
        "en": "Know this today",
        "hi": "यह आज ही जान लो"
      },
      "transliterations": {
        "devanagari": "तिळिदुको ई होत्तु",
        "latin": "tiḷiduko ī hottu"
      },
      "type": "poem_line"
    },
