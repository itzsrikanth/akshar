  "labels": {
    "exercise-A": {
      "devanagari": "अ) पद्यद मुन्दिन सालुगळन्नु हेळि:",
      "en": "A) Say the next lines of the poem:",
      "hi": "अ) कविता की अगली पंक्तियाँ बताएँ:",
      "kn": "ಅ) ಪದ್ಯದ ಮುಂದಿನ ಸಾಲುಗಳನ್ನು ಹೇಳಿ:",
      "latin": "a) padyada mundina sālugaḷannu hēḷi:"
    },
    "exercise-B": {
      "devanagari": "आ) ई प्रश्नेगळिगे ओन्दु पददल्लि उत्तर बरेयिरि:",
      "en": "B) Write the answer to these questions in one word:",
      "hi": "आ) इन प्रश्नों के उत्तर एक शब्द में लिखें:",
      "kn": "ಆ) ಈ ಪ್ರಶ್ನೆಗಳಿಗೆ ಒಂದು ಪದದಲ್ಲಿ ಉತ್ತರ ಬರೆಯಿರಿ:",
      "latin": "ā) ī praśnegaḷige ondu padadalli uttara bareyiri:"
    },
    "exercise-C": {
      "devanagari": "इ) आवरणदल्लि इरुव पदगळल्लि सूक्त पद आरिसि खालि बिट्ट स्थळदल्लि बरेयिरि:",
      "en": "C) Choose the appropriate word from brackets and write in the blanks:",
      "hi": "इ) कोष्ठक में दिए गए शब्दों में से उचित शब्द चुनकर रिक्त स्थान में लिखें:",
      "kn": "ಇ) ಆವರಣದಲ್ಲಿ ಇರುವ ಪದಗಳಲ್ಲಿ ಸೂಕ್ತ ಪದ ಆರಿಸಿ ಖಾಲಿ ಬಿಟ್ಟ ಸ್ಥಳದಲ್ಲಿ ಬರೆಯಿರಿ:",
      "latin": "i) āvaraṇadalli iruva padagaḷalli sūkta pada ārisi khāli biṭṭa sthaḷadalli bareyiri:"
    },
    "exercise-D": {
      "devanagari": "ई) ई प्रास पदगळन्नु हेळु:",
      "en": "D) Say these rhyming words:",
      "hi": "ई) ये तुकांत शब्द बताएँ:",
      "kn": "ಈ) ಈ ಪ್ರಾಸ ಪದಗಳನ್ನು ಹೇಳು:",
      "latin": "ī) ī prāsa padagaḷannu hēḷu:"
    },
