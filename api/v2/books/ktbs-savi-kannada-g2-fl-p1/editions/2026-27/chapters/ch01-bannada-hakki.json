  "segments": [
    {
      "id": "poem-s1l1",
      "stanza": 1,
      "text": "ಬಾರಲೆ ಹಕ್ಕಿ ಬಣ್ಣದ ಹಕ್ಕಿ",
      "translations": {
        "en": "Come bird, colorful bird",
        "hi": "आ जा चिड़िया, रंग-बिरंगी चिड़िया"
      },
      "transliterations": {
        "devanagari": "बारले हक्कि बण्णद हक्कि",
        "latin": "bārale hakki baṇṇada hakki"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "stanza": 1,
      "text": "ಬಾರಲೆ ಹಕ್ಕಿ ಹಾರುವ ಹಕ್ಕಿ",
      "translations": {
        "en": "Come bird, flying bird",
        "hi": "आ जा चिड़िया, उड़ने वाली चिड़िया"
      },
      "transliterations": {
        "devanagari": "बारले हक्कि हारुव हक्कि",
        "latin": "bārale hakki hāruva hakki"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l3",
      "stanza": 1,
      "text": "ಗೆಳೆಯರು ಆಡಲು ಯಾರೂ ಇಲ್ಲ",
      "translations": {
        "en": "There is no one to play with",
        "hi": "खेलने के लिए कोई दोस्त नहीं है"
      },
      "transliterations": {
        "devanagari": "गेळेयरु आडलु यारू इल्ल",
        "latin": "geḷeyaru āḍalu yārū illa"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l4",
      "stanza": 1,
      "text": "ಕಳೆಯುವುದೆಂತು ವೇಳೆಯನೆಲ್ಲ",
      "translations": {
        "en": "How to spend all the time",
        "hi": "सारा समय कैसे बिताऊँ"
      },
      "transliterations": {
        "devanagari": "कळेयुवुदेन्तु वेळेयनेल्ल",
        "latin": "kaḷeyuvudentu vēḷeyanella"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "stanza": 2,
      "text": "ಬಾ ಬಾ ನನಗೂ ಹಾಡಲು ಕಲಿಸು",
      "translations": {
        "en": "Come come, teach me to sing too",
        "hi": "आ आ मुझे भी गाना सिखा"
      },
      "transliterations": {
        "devanagari": "बा बा ननगू हाडलु कलिसु",
        "latin": "bā bā nanagū hāḍalu kalisu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "stanza": 2,
      "text": "ಬಾ ಬಾ ನನಗೂ ಹಾರಲು ಕಲಿಸು",
      "translations": {
        "en": "Come come, teach me to fly too",
        "hi": "आ आ मुझे भी उड़ना सिखा"
      },
      "transliterations": {
        "devanagari": "बा बा ननगू हारलु कलिसु",
        "latin": "bā bā nanagū hāralu kalisu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l3",
      "stanza": 2,
      "text": "ಅವ್ವನು ನೀರಿಗೆ ಹೋಗಿಹಳು",
      "translations": {
        "en": "Mother has gone to fetch water",
        "hi": "माँ पानी लेने गई है"
      },
      "transliterations": {
        "devanagari": "अव्वनु नीरिगे होगिहळु",
        "latin": "avvanu nīrige hōgihaḷu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l4",
      "stanza": 2,
      "text": "ಅಪ್ಪನು ಪೇಟೆಗೆ ಹೋಗಿಹನು",
      "translations": {
        "en": "Father has gone to the market",
        "hi": "पिताजी बाज़ार गए हैं"
      },
      "transliterations": {
        "devanagari": "अप्पनु पेटेगे होगिहनु",
        "latin": "appanu pēṭege hōgihanu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "stanza": 3,
      "text": "ಅವ್ವನು ಬರಲಿ ಅಪ್ಪನು ಬರಲಿ",
      "translations": {
        "en": "Let mother come, let father come",
        "hi": "माँ को आने दे, पिताजी को आने दे"
      },
      "transliterations": {
        "devanagari": "अव्वनु बरलि अप्पनु बरलि",
        "latin": "avvanu barali appanu barali"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "stanza": 3,
      "text": "ತಿನ್ನಲು ಹಣ್ಣನು ಕೊಡಿಸುವೆನು",
      "translations": {
        "en": "I will buy you fruit to eat",
        "hi": "मैं तुझे खाने के लिए फल दिलाऊँगा"
      },
      "transliterations": {
        "devanagari": "तिन्नलु हण्णनु कोडिसुवेनु",
        "latin": "tinnalu haṇṇanu koḍisuvenu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l3",
      "stanza": 3,
      "text": "ನನಗೂ ಎರಡು ರೆಕ್ಕೆಯ ಹಚ್ಚು",
      "translations": {
        "en": "Stick two wings on me too",
        "hi": "मुझे भी दो पंख लगा दे"
      },
      "transliterations": {
        "devanagari": "ननगू एरडु रेक्केय हच्चु",
        "latin": "nanagū eraḍu rekkeya haccu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l4",
      "stanza": 3,
      "text": "ಹಿಂಗಡೆ ಬಣ್ಣದ ಪುಚ್ಚವ ಚುಚ್ಚು",
      "translations": {
        "en": "Poke a colorful feather behind",
        "hi": "पीछे एक रंगीन पंख चुभा दे"
      },
      "transliterations": {
        "devanagari": "हिङ्गडे बण्णद पुच्चव चुच्चु",
        "latin": "hiṅgaḍe baṇṇada puccava cuccu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l1",
      "stanza": 4,
      "text": "ನೆತ್ತಿಯ ಮೇಲೆ ಜುಟ್ಟನು ಹಚ್ಚು",
      "translations": {
        "en": "Stick a tuft on top of the head",
        "hi": "सिर के ऊपर एक चोटी लगा दे"
      },
      "transliterations": {
        "devanagari": "नेत्तिय मेले जुट्टनु हच्चु",
        "latin": "nettiya mēle juṭṭanu haccu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l2",
      "stanza": 4,
      "text": "ಮೆಲ್ಲನೆ ಮೇಲೆ ಹಾರಲು ಹಚ್ಚು",
      "translations": {
        "en": "Gently make me fly up",
        "hi": "धीरे-से मुझे ऊपर उड़ना सिखा दे"
      },
      "transliterations": {
        "devanagari": "मेल्लने मेले हारलु हच्चु",
        "latin": "mellane mēle hāralu haccu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l3",
      "stanza": 4,
      "text": "ನಾನು ನೀನೂ ಇಬ್ಬರು ಕೂಡಿ",
      "translations": {
        "en": "You and I, both together",
        "hi": "मैं और तू दोनों मिलकर"
      },
      "transliterations": {
        "devanagari": "नानु नीनू इब्बरु कूडि",
        "latin": "nānu nīnū ibbaru kūḍi"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l4",
      "stanza": 4,
      "text": "ಮುಗಿಲಿನ ಕಡೆಗೆ ಹಾರುವ ಬಾ",
      "translations": {
        "en": "Come, let's fly towards the sky",
        "hi": "आ, आसमान की ओर उड़ें"
      },
      "transliterations": {
        "devanagari": "मुगिलिन कडेगे हारुव बा",
        "latin": "mugilina kaḍege hāruva bā"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l1",
      "stanza": 5,
      "text": "ಅಲ್ಲಿಂದಿತ್ತ ಇಲ್ಲಿಂದತ್ತ",
      "translations": {
        "en": "From there to here, from here to there",
        "hi": "वहाँ से यहाँ, यहाँ से वहाँ"
      },
      "transliterations": {
        "devanagari": "अल्लिन्दित्त इल्लिन्दत्त",
        "latin": "allinditta illindatta"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l2",
      "stanza": 5,
      "text": "ಹಾರುತ ಹಾಡುತ ನಲಿಯುವ ಬಾ",
      "translations": {
        "en": "Come, let's fly, sing, and rejoice",
        "hi": "आ, उड़ें, गाएँ और खुशियाँ मनाएँ"
      },
      "transliterations": {
        "devanagari": "हारुत हाडुत नलियुव बा",
        "latin": "hāruta hāḍuta naliyuva bā"
      },
      "type": "poem_line"
    },
