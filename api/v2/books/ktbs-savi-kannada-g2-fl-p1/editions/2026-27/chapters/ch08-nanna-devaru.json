  "labels": {
    "exercise-A": {
      "devanagari": "अ) 'नन्न देवरु' पद्यवन्नु रागवागि हाडि:",
      "en": "A) Sing the poem 'My God' melodiously:",
      "hi": "अ) 'मेरा देवता' कविता को राग के साथ गाओ:",
      "kn": "ಅ) 'ನನ್ನ ದೇವರು' ಪದ್ಯವನ್ನು ರಾಗವಾಗಿ ಹಾಡಿ:",
      "latin": "a) 'nanna dēvaru' padyavannu rāgavāgi hāḍi:"
    },
    "exercise-B": {
      "devanagari": "आ) ओंदु वाक्यदल्लि उत्तर हेळिरि:",
      "en": "B) Answer in one sentence:",
      "hi": "आ) एक वाक्य में उत्तर कहो:",
      "kn": "ಆ) ಒಂದು ವಾಕ್ಯದಲ್ಲಿ ಉತ್ತರ ಹೇಳಿರಿ:",
      "latin": "ā) ondu vākyadalli uttara hēḷiri:"
    },
    "exercise-C": {
      "devanagari": "इ) प्रश्नेगळिगे ओंदु वाक्यदल्लि उत्तरिसि:",
      "en": "C) Answer the questions in one sentence:",
      "hi": "इ) प्रश्नों के उत्तर एक वाक्य में दो:",
      "kn": "ಇ) ಪ್ರಶ್ನೆಗಳಿಗೆ ಒಂದು ವಾಕ್ಯದಲ್ಲಿ ಉತ್ತರಿಸಿ:",
      "latin": "i) praśnegaḷige ondu vākyadalli uttarisi:"
    },
    "exercise-D": {
      "devanagari": "ई) गुंपिगे सेरद पद गुरुतिसि बरेयिरि :",
      "en": "D) Identify and write the word that does not belong to the group:",
      "hi": "ई) समूह में न आने वाले शब्द को पहचानकर लिखो :",
      "kn": "ಈ) ಗುಂಪಿಗೆ ಸೇರದ ಪದ ಗುರುತಿಸಿ ಬರೆಯಿರಿ :",
      "latin": "ī) gumpige sērada pada gurutisi bareyiri :"
    },
    "exercise-E": {
      "devanagari": "उ) मादरियंते पद बरे :",
      "en": "E) Write words as in the model:",
      "hi": "उ) नमूने के अनुसार शब्द लिखो :",
      "kn": "ಉ) ಮಾದರಿಯಂತೆ ಪದ ಬರೆ :",
      "latin": "u) mādariyante pada bare :"
    },
    "exercise-F": {
      "devanagari": "ऊ) ई कथेयन्नु ओदि कोट्टिरुव प्रश्नेगळिगे उत्तर बरेयिरि :",
      "en": "F) Read this story and write answers to the given questions:",
      "hi": "ऊ) इस कहानी को पढ़कर दिए गए प्रश्नों के उत्तर लिखो :",
      "kn": "ಊ) ಈ ಕಥೆಯನ್ನು ಓದಿ ಕೊಟ್ಟಿರುವ ಪ್ರಶ್ನೆಗಳಿಗೆ ಉತ್ತರ ಬರೆಯಿರಿ :",
      "latin": "ū) ī katheyannu ōdi koṭṭiruva praśnegaḷige uttara bareyiri :"
    },
