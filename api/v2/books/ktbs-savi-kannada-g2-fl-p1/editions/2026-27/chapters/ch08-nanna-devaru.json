  "segments": [
    {
      "id": "poem-s1l1",
      "stanza": 1,
      "text": "ನಿತ್ಯ ನಮಗೆ ಬೆಳಕು ಕೊಡುವ",
      "translations": {
        "en": "Who gives us light every day",
        "hi": "नित्य हमें प्रकाश देने वाला"
      },
      "transliterations": {
        "devanagari": "नित्य नमगे बेळकु कोडुव",
        "latin": "nitya namage beḷaku koḍuva"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "stanza": 1,
      "text": "ಸೂರ್ಯ ನನ್ನ ದೇವರು",
      "translations": {
        "en": "the sun is my God",
        "hi": "सूर्य मेरा देवता है"
      },
      "transliterations": {
        "devanagari": "सूर्य नन्न देवरु",
        "latin": "sūrya nanna dēvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l3",
      "stanza": 1,
      "text": "ರಾತ್ರಿ ಹಾಲು ಬೆಳಕು ಕೊಡುವ",
      "translations": {
        "en": "Who gives milky light at night",
        "hi": "रात में दूध-सा प्रकाश देने वाला"
      },
      "transliterations": {
        "devanagari": "रात्रि हालु बेळकु कोडुव",
        "latin": "rātri hālu beḷaku koḍuva"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l4",
      "stanza": 1,
      "text": "ಚಂದ್ರ ನನ್ನ ದೇವರು",
      "translations": {
        "en": "the moon is my God",
        "hi": "चंद्र मेरा देवता है"
      },
      "transliterations": {
        "devanagari": "चंद्र नन्न देवरु",
        "latin": "caṁdra nanna dēvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "stanza": 2,
      "text": "ಕೋಟಿ ತಾರೆ ಬೆಳ್ಳಿ ಚುಕ್ಕಿ",
      "translations": {
        "en": "Crores of stars, silver dots",
        "hi": "करोड़ों तारे चाँदी की बिंदियाँ"
      },
      "transliterations": {
        "devanagari": "कोटि तारे बेळ्ळि चुक्कि",
        "latin": "kōṭi tāre beḷḷi cukki"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "stanza": 2,
      "text": "ಉಲ್ಕೆ ನನ್ನ ದೇವರು",
      "translations": {
        "en": "the meteor is my God",
        "hi": "उल्का मेरा देवता है"
      },
      "transliterations": {
        "devanagari": "उल्के नन्न देवरु",
        "latin": "ulke nanna dēvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l3",
      "stanza": 2,
      "text": "ಬೆಂಕಿ ಗಾಳಿ ನೀರು ಗಗನ",
      "translations": {
        "en": "Fire, wind, water, sky",
        "hi": "आग, हवा, जल, आकाश"
      },
      "transliterations": {
        "devanagari": "बेंकि गाळि नीरु गगन",
        "latin": "beṁki gāḷi nīru gagana"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l4",
      "stanza": 2,
      "text": "ಎಲ್ಲ ನನ್ನ ದೇವರು",
      "translations": {
        "en": "all are my God",
        "hi": "सब मेरे देवता हैं"
      },
      "transliterations": {
        "devanagari": "एल्ल नन्न देवरु",
        "latin": "ella nanna dēvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "stanza": 3,
      "text": "ಹಚ್ಚ ಹಸಿರು ಹೊದ್ದು ನಿಂತ",
      "translations": {
        "en": "Standing wrapped in deep green",
        "hi": "गहरा हरा ओढ़कर खड़ी"
      },
      "transliterations": {
        "devanagari": "हच्च हसिरु होद्दु निंत",
        "latin": "hacca hasiru hoddu niṁta"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "stanza": 3,
      "text": "ಭೂಮಿ ನನ್ನ ದೇವರು",
      "translations": {
        "en": "the earth is my God",
        "hi": "भूमि मेरा देवता है"
      },
      "transliterations": {
        "devanagari": "भूमि नन्न देवरु",
        "latin": "bhūmi nanna dēvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l3",
      "stanza": 3,
      "text": "ಗುಡ್ಡ - ಬೆಟ್ಟ ಕಾಡು ಮೇಡು",
      "translations": {
        "en": "Hills - mountains, forests, plains",
        "hi": "पहाड़ - पर्वत, वन, मैदान"
      },
      "transliterations": {
        "devanagari": "गुड्ड - बेट्ट काडु मेडु",
        "latin": "guḍḍa - beṭṭa kāḍu mēḍu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l4",
      "stanza": 3,
      "text": "ಹೊಳೆಗಳೆನ್ನ ದೇವರು",
      "translations": {
        "en": "the streams are my God",
        "hi": "नदियाँ मेरे देवता हैं"
      },
      "transliterations": {
        "devanagari": "होळेगळेन्न देवरु",
        "latin": "hoḷegaḷenna dēvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l1",
      "stanza": 4,
      "text": "ಹೊಲದಿ ಬೆವರು ಸುರಿಸಿ ದುಡಿವ",
      "translations": {
        "en": "Who toils shedding sweat in the field",
        "hi": "खेत में पसीना बहाकर मेहनत करने वाला"
      },
      "transliterations": {
        "devanagari": "होलदि बेवरु सुरिसि दुडिव",
        "latin": "holadi bevaru surisi duḍiva"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l2",
      "stanza": 4,
      "text": "ರೈತ ನನ್ನ ದೇವರು",
      "translations": {
        "en": "the farmer is my God",
        "hi": "किसान मेरा देवता है"
      },
      "transliterations": {
        "devanagari": "रैत नन्न देवरु",
        "latin": "raita nanna dēvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l3",
      "stanza": 4,
      "text": "ದೇಶಕಾಗಿ ಶ್ರಮಿಸುತಿರುವ",
      "translations": {
        "en": "Who strives for the country",
        "hi": "देश के लिए परिश्रम करने वाला"
      },
      "transliterations": {
        "devanagari": "देशकागि श्रमिसुतिरुव",
        "latin": "dēśakāgi śramisutiruva"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l4",
      "stanza": 4,
      "text": "ಯೋಧ ನನ್ನ ದೇವರು",
      "translations": {
        "en": "the soldier is my God",
        "hi": "योद्धा मेरा देवता है"
      },
      "transliterations": {
        "devanagari": "योध नन्न देवरु",
        "latin": "yōdha nanna dēvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l1",
      "stanza": 5,
      "text": "ತಂದೆ - ತಾಯಿ ಬಂಧು ಬಳಗ-",
      "translations": {
        "en": "Father - mother, kin and clan-",
        "hi": "पिता - माता, बंधु-बांधव-"
      },
      "transliterations": {
        "devanagari": "तंदे - तायि बंधु बळग-",
        "latin": "taṁde - tāyi baṁdhu baḷaga-"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l2",
      "stanza": 5,
      "text": "ವೆಲ್ಲ ನನ್ನ ದೇವರು",
      "translations": {
        "en": "all are my God",
        "hi": "सब मेरे देवता हैं"
      },
      "transliterations": {
        "devanagari": "वेल्ल नन्न देवरु",
        "latin": "vella nanna dēvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l3",
      "stanza": 5,
      "text": "ವಿದ್ಯೆ ಕಲಿಸಿ ಹಿತವ ನುಡಿವ",
      "translations": {
        "en": "Who teach knowledge and speak kindly",
        "hi": "विद्या सिखाकर हित की बात कहने वाले"
      },
      "transliterations": {
        "devanagari": "विद्ये कलिसि हितव नुडिव",
        "latin": "vidye kalisi hitava nuḍiva"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l4",
      "stanza": 5,
      "text": "ಗುರುಗಳೆನ್ನ ದೇವರು",
      "translations": {
        "en": "the teachers are my God",
        "hi": "गुरुजन मेरे देवता हैं"
      },
      "transliterations": {
        "devanagari": "गुरुगळेन्न देवरु",
        "latin": "gurugaḷenna dēvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l1",
      "stanza": 6,
      "text": "ನನ್ನ ದೇವರಿವರು ನಿತ್ಯ",
      "translations": {
        "en": "These gods of mine always",
        "hi": "मेरे ये देवता नित्य"
      },
      "transliterations": {
        "devanagari": "नन्न देवरिवरु नित्य",
        "latin": "nanna dēvarivaru nitya"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l2",
      "stanza": 6,
      "text": "ನನಗೆ ಕಾಣುತಿರುವರು",
      "translations": {
        "en": "are visible to me",
        "hi": "मुझे दिखाई देते हैं"
      },
      "transliterations": {
        "devanagari": "ननगे काणुतिरुवरु",
        "latin": "nanage kāṇutiruvaru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l3",
      "stanza": 6,
      "text": "ಶುದ್ಧ ಮನದಿ ಬೇಡಿದುದನು",
      "translations": {
        "en": "What is asked with a pure mind",
        "hi": "शुद्ध मन से जो माँगा"
      },
      "transliterations": {
        "devanagari": "शुद्ध मनदि बेडिदुदनु",
        "latin": "śuddha manadi bēḍidudanu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l4",
      "stanza": 6,
      "text": "ನೀಡಿ ಪೊರೆಯುತಿರುವರು",
      "translations": {
        "en": "they give and protect",
        "hi": "देकर मेरी रक्षा करते हैं"
      },
      "transliterations": {
        "devanagari": "नीडि पोरेयुतिरुवरु",
        "latin": "nīḍi poreyutiruvaru"
      },
      "type": "poem_line"
    },
    {
