    {
      "id": "poem-s5l4",
      "section": "poem",
      "stanza": 5,
      "text": "ಮುತ್ತೈದೆ ಎಲೆ ಹೆಣ್ಣೆ ತೋರುಬಾರೆ ತವರೂರ",
      "translations": {
        "en": "Married woman, O girl, come show the maternal village"
      },
      "transliterations": {
        "devanagari": "मुत्तैदॆ ऎलॆ हॆण्णॆ तोरुबारॆ तवरूर",
        "latin": "muttaidè èlè hèṇṇè torubārè tavarūra"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l1",
      "section": "poem",
      "stanza": 6,
      "text": "ಅಚ್ಚ ಕೆಂಪಿನ ಬಳೆ ಹಸಿರು ಗೀರಿನ ಬಳೆ",
      "translations": {
        "en": "Deep red bangles, green-lined bangles"
      },
      "transliterations": {
        "devanagari": "अच्च कॆंपिन बळॆ हसिरु गीरिन बळॆ",
        "latin": "acca kèṃpina baḻè hasiru gīrina baḻè"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l2",
      "section": "poem",
      "stanza": 6,
      "text": "ಎನ್ನ ಹಡೆದವ್ಗೆ ಬಲು ಆಸೆ ಬಳೆಗಾರ",
      "translations": {
        "en": "My birth mother greatly desires, bangle-seller"
      },
      "transliterations": {
        "devanagari": "ऎन्न हडॆदव्गॆ बलु आसॆ बळॆगार",
        "latin": "ènna haḍèdavgè balu āsè baḻègāra"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l3",
      "section": "poem",
      "stanza": 6,
      "text": "ಕೊಂಡ್ಹೋಗೊ ಎನ್ನ ತವರೀಗೆ|",
      "translations": {
        "en": "Take them to my maternal home|"
      },
      "transliterations": {
        "devanagari": "कॊंड्होगॊ ऎन्न तवरीगॆ|",
        "latin": "kòṃḍhogò ènna tavarīgè|"
