  "schemaVersion": "2.0",
  "segments": [
    {
      "id": "intro-1",
      "section": "intro",
      "text": "ಕಾಮನಬಿಲ್ಲು ಎಲ್ಲಿ? ಯಾವಾಗ? ಹೇಗೆ ಕಾಣಿಸುತ್ತದೆ ಎಂದು ಶಿಕ್ಷಕರ ಮಾರ್ಗದರ್ಶನದಲ್ಲಿ ತರಗತಿಯಲ್ಲಿ ಚರ್ಚಿಸಿ.",
      "translations": {
        "en": "Where is the rainbow? When? Discuss in class under the teacher’s guidance how it appears.",
        "hi": "इंद्रधनुष कहाँ? कब? कैसे दिखाई देता है — शिक्षक के मार्गदर्शन में कक्षा में चर्चा करो।"
      },
      "transliterations": {
        "devanagari": "कामनबिल्लु ऎल्लि? यावाग? हेगॆ काणिसुत्तदॆ ऎंदु शिक्षकर मार्गदर्शनदल्लि तरगतियल्लि चर्चिसि.",
        "latin": "Kaamanabillu elli? yaavaaga? hege kaanisuttade endu shikshakara maargadarshanadalli taragatiyalli charchisi."
      },
      "type": "prose"
    },
    {
      "id": "poem-s1l1",
      "section": "poem",
      "stanza": 1,
      "text": "ಬಿಸಿಲ ಝಳಕೆ ಕಡಲ ನೀರು",
      "translations": {
        "en": "Sea water in the heat of the sun",
        "hi": "धूप की तपन से समुद्र का पानी"
      },
      "transliterations": {
        "devanagari": "बिसिल झळकॆ कडल नीरु",
        "latin": "Bisila jhalake kadala neeru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "section": "poem",
      "stanza": 1,
      "text": "ಆವಿಯಾಯಿತು |",
      "translations": {
        "en": "became vapour |",
        "hi": "वाष्प बन गया |"
      },
      "transliterations": {
        "devanagari": "आवियायितु |",
        "latin": "Aaviyaayitu |"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l3",
      "section": "poem",
      "stanza": 1,
      "text": "ಆವಿಯಾಗಿ ನೆಲದ ಕಡೆಗೆ",
      "translations": {
        "en": "As vapour, towards the land",
        "hi": "वाष्प बनकर धरती की ओर"
      },
      "transliterations": {
        "devanagari": "आवियागि नॆलद कडॆगॆ",
        "latin": "Aaviyaagi nelada kadege"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l4",
      "section": "poem",
      "stanza": 1,
      "text": "ಬೀಸಿ ಬಂದಿತು॥",
      "translations": {
        "en": "it blew and came॥",
        "hi": "बहकर आया॥"
      },
      "transliterations": {
        "devanagari": "बीसि बंदितु॥",
        "latin": "Beesi banditu॥"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "section": "poem",
      "stanza": 2,
      "text": "ನೆಲದ ಮೇಲೆ ಗುಡ್ಡಬೆಟ್ಟ",
      "translations": {
        "en": "On the land, hills and mountains",
        "hi": "धरती पर पहाड़-पहाड़ियाँ"
      },
      "transliterations": {
        "devanagari": "नॆलद मेलॆ गुड्डबॆट्ट",
        "latin": "Nelada mele guddabetta"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "section": "poem",
      "stanza": 2,
      "text": "ಅಡ್ಡವಾಯಿತು |",
      "translations": {
        "en": "stood in the way |",
        "hi": "आड़े आ गईं |"
      },
      "transliterations": {
        "devanagari": "अड्डवायितु |",
        "latin": "Addavaayitu |"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l3",
      "section": "poem",
      "stanza": 2,
      "text": "ತಡೆದು ನಿಂತ ಮೋಡವೆಲ್ಲ",
      "translations": {
        "en": "All the clouds that were stopped",
        "hi": "रुककर खड़े सारे बादल"
      },
      "transliterations": {
        "devanagari": "तडॆदु निंत मोडवॆल्ल",
        "latin": "Tadedu ninta modavella"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l4",
      "section": "poem",
      "stanza": 2,
      "text": "ಮೇಲಕೇರಿತು॥",
      "translations": {
        "en": "rose upward॥",
        "hi": "ऊपर चढ़ गए॥"
      },
      "transliterations": {
        "devanagari": "मेलकेरितु॥",
        "latin": "Melakeritu॥"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "section": "poem",
      "stanza": 3,
      "text": "ಘಳಿಗೆಯೊಳಗೆ ಬಾನು ತುಂಬ",
      "translations": {
        "en": "Within a ghalige the whole sky",
        "hi": "एक घड़ी में आकाश भर"
      },
      "transliterations": {
        "devanagari": "घळिगॆयॊळगॆ बानु तुंब",
        "latin": "Ghaligeyolage baanu tunba"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "section": "poem",
      "stanza": 3,
      "text": "ಮೋಡ ಕವಿಯಿತು |",
      "translations": {
        "en": "was covered with cloud |",
        "hi": "बादल छा गए |"
      },
      "transliterations": {
        "devanagari": "मोड कवियितु |",
        "latin": "Moda kaviyitu |"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l3",
      "section": "poem",
      "stanza": 3,
      "text": "ಮಿಂಚು ಮಿಂಚಿ ಜಗವು ಬೆಳಗಿ",
      "translations": {
        "en": "Lightning flashed, lighting the world",
        "hi": "बिजली चमककर जग प्रकाशित"
      },
      "transliterations": {
        "devanagari": "मिंचु मिंचि जगवु बॆळगि",
        "latin": "Minchu minchi jagavu belagi"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l4",
      "section": "poem",
      "stanza": 3,
      "text": "ಗುಡುಗು ಗುಡುಗಿತು॥",
      "translations": {
        "en": "and thunder roared॥",
        "hi": "और गर्जन हुआ॥"
      },
      "transliterations": {
        "devanagari": "गुडुगु गुडुगितु॥",
        "latin": "Gudugu gudugitu॥"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l1",
      "section": "poem",
      "stanza": 4,
      "text": "ಮೋಡ ಮೇಲಕೇರಿದಾಗ",
      "translations": {
        "en": "When the cloud rose upward",
        "hi": "बादल ऊपर चढ़े तब"
      },
      "transliterations": {
        "devanagari": "मोड मेलकेरिदाग",
        "latin": "Moda melakeridaaga"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l2",
      "section": "poem",
      "stanza": 4,
      "text": "ತಂಪು ತಗುಲಿತು |",
      "translations": {
        "en": "coolness touched it |",
        "hi": "ठंडक लगी |"
      },
      "transliterations": {
        "devanagari": "तंपु तगुलितु |",
        "latin": "Tanpu tagulitu |"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l3",
      "section": "poem",
      "stanza": 4,
      "text": "ಆವಿ ತಣಿದು ಭಾರವಾಗಿ",
      "translations": {
        "en": "The vapour cooled, grew heavy",
        "hi": "वाष्प ठंडी होकर भारी हुई"
      },
      "transliterations": {
        "devanagari": "आवि तणिदु भारवागि",
        "latin": "Aavi tanidu bhaaravaagi"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l4",
      "section": "poem",
      "stanza": 4,
      "text": "ಕುಸಿಯತೊಡಗಿತು॥",
      "translations": {
        "en": "and began to fall॥",
        "hi": "और गिरने लगी॥"
      },
      "transliterations": {
        "devanagari": "कुसियतॊडगितु॥",
        "latin": "Kusiyatodagitu॥"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l1",
      "section": "poem",
      "stanza": 5,
      "text": "ಮುತ್ತಿನಂಥ ಮಳೆಯ ನೀರು",
      "translations": {
        "en": "Pearl-like rain water",
        "hi": "मोती जैसा वर्षा का जल"
      },
      "transliterations": {
        "devanagari": "मुत्तिनंथ मळॆय नीरु",
        "latin": "Muttinantha maleya neeru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l2",
      "section": "poem",
      "stanza": 5,
      "text": "ಕೆಳಗೆ ಸುರಿಯಿತು |",
      "translations": {
        "en": "poured down |",
        "hi": "नीचे बरस पड़ा |"
      },
      "transliterations": {
        "devanagari": "कॆळगॆ सुरियितु |",
        "latin": "Kelage suriyitu |"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l3",
      "section": "poem",
      "stanza": 5,
      "text": "ಕೆರೆಯು ತೊರೆಯು ಹಳ್ಳ ಹೊಳೆಯು",
      "translations": {
        "en": "Lake and stream, brook and river",
