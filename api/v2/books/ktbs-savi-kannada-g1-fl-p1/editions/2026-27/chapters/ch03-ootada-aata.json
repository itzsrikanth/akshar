  "segments": [
    {
      "id": "intro-1",
      "section": "intro",
      "text": "ಅ) ಚಿತ್ರ ತೋರಿಸಿ, ಪದ ಹೇಳಿಸಿ.",
      "translations": {
        "en": "A) Show the picture and have the children say the word.",
        "hi": "अ) चित्र दिखाकर शब्द बुलवाएँ।"
      },
      "transliterations": {
        "devanagari": "अ) चित्र तोरिसि, पद हेळिसि.",
        "latin": "a) citra torisi, pada heḻisi."
      },
      "type": "prose"
    },
    {
      "id": "intro-moogu",
      "section": "intro",
      "text": "ಮೂಗು",
      "translations": {
        "en": "nose",
        "hi": "नाक"
      },
      "transliterations": {
        "devanagari": "मूगु",
        "latin": "mūgu"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "intro-kannugalu",
      "section": "intro",
      "text": "ಕಣ್ಣುಗಳು",
      "translations": {
        "en": "eyes",
        "hi": "आँखें"
      },
      "transliterations": {
        "devanagari": "कण्णुगळु",
        "latin": "kaṇṇugaḻu"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "intro-elegalu",
      "section": "intro",
      "text": "ಎಲೆಗಳು",
      "translations": {
        "en": "leaves",
        "hi": "पत्तियाँ"
      },
      "transliterations": {
        "devanagari": "ऎलॆगळु",
        "latin": "èlègaḻu"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "intro-hoogalu",
      "section": "intro",
      "text": "ಹೂಗಳು",
      "translations": {
        "en": "flowers",
        "hi": "फूल"
      },
      "transliterations": {
        "devanagari": "हूगळु",
        "latin": "hūgaḻu"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "intro-kai-beralgu",
      "section": "intro",
      "text": "ಕೈ ಬೆರಳುಗಳು",
      "translations": {
        "en": "fingers of the hand",
        "hi": "हाथ की उंगलियाँ"
      },
      "transliterations": {
        "devanagari": "कै बॆरळुगळु",
        "latin": "kai bèraḻugaḻu"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "poem-intro",
      "section": "poem",
      "text": "(ಈ ಪದ್ಯವನ್ನು ರಾಗವಾಗಿ ಹಾಡಿ ಮಕ್ಕಳಿಂದ ಹೇಳಿಸಿ)",
      "translations": {
        "en": "(Sing this poem tunefully and have the children say it)",
        "hi": "(इस पद्य को राग से गाकर बच्चों से बुलवाएँ)"
      },
      "transliterations": {
        "devanagari": "(ई पद्यवन्नु रागवागि हाडि मक्कळिंद हेळिसि)",
        "latin": "(ī padyavannu rāgavāgi hāḍi makkaḻiṃda heḻisi)"
      },
      "type": "prose"
    },
    {
      "id": "poem-s1l1",
      "stanza": 1,
      "text": "ಒಂದು ಎರಡು",
      "translations": {
        "en": "One two",
        "hi": "एक दो"
      },
      "transliterations": {
        "devanagari": "ऒंदु ऎरडु",
        "latin": "òṃdu èraḍu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "stanza": 1,
      "text": "ಬಾಳೆಲೆ ಹರಡು",
      "translations": {
        "en": "Spread the banana leaf",
        "hi": "केले का पत्ता बिछाओ"
      },
      "transliterations": {
        "devanagari": "बाळॆलॆ हरडु",
        "latin": "bāḻèlè haraḍu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "stanza": 2,
      "text": "ಮೂರು ನಾಲ್ಕು",
      "translations": {
        "en": "Three four",
        "hi": "तीन चार"
      },
      "transliterations": {
        "devanagari": "मूरु नाल्कु",
        "latin": "mūru nālku"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "stanza": 2,
      "text": "ಅನ್ನ ಹಾಕು",
      "translations": {
        "en": "Serve the rice",
        "hi": "भात डालो"
      },
      "transliterations": {
        "devanagari": "अन्न हाकु",
        "latin": "anna hāku"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "stanza": 3,
      "text": "ಐದು ಆರು",
      "translations": {
        "en": "Five six",
        "hi": "पाँच छह"
      },
      "transliterations": {
        "devanagari": "ऐदु आरु",
        "latin": "aidu āru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "stanza": 3,
      "text": "ಬೇಳೆ ಸಾರು",
      "translations": {
        "en": "Lentil soup (saaru)",
        "hi": "दाल सारु"
      },
      "transliterations": {
        "devanagari": "बेळॆ सारु",
        "latin": "beḻè sāru"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l1",
      "stanza": 4,
      "text": "ಏಳು ಎಂಟು",
      "translations": {
        "en": "Seven eight",
        "hi": "सात आठ"
      },
      "transliterations": {
        "devanagari": "एळु ऎंटु",
        "latin": "eḻu èṃṭu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l2",
      "stanza": 4,
      "text": "ಪಲ್ಯಕೆ ದಂಟು",
      "translations": {
        "en": "Greens for the side dish",
        "hi": "सब्जी के लिए डंठल"
      },
      "transliterations": {
        "devanagari": "पल्यकॆ दंटु",
        "latin": "palyakè daṃṭu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l1",
      "stanza": 5,
      "text": "ಒಂಬತ್ತು ಹತ್ತು",
      "translations": {
        "en": "Nine ten",
        "hi": "नौ दस"
      },
      "transliterations": {
        "devanagari": "ऒंबत्तु हत्तु",
        "latin": "òṃbattu hattu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l2",
      "stanza": 5,
      "text": "ಎಲೆ ಮುದಿರೆತ್ತು",
      "translations": {
        "en": "Fold up the leaf",
        "hi": "पत्ता मोड़कर उठाओ"
      },
      "transliterations": {
        "devanagari": "ऎलॆ मुदिरॆत्तु",
        "latin": "èlè mudirèttu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l1",
      "stanza": 6,
      "text": "ಒಂದರಿಂದ ಹತ್ತು",
      "translations": {
        "en": "From one to ten",
        "hi": "एक से दस"
      },
      "transliterations": {
        "devanagari": "ऒंदरिंद हत्तु",
        "latin": "òṃdariṃda hattu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l2",
      "stanza": 6,
      "text": "ಹೀಗಿತ್ತು",
      "translations": {
        "en": "It was like this",
        "hi": "ऐसा ही था"
      },
      "transliterations": {
        "devanagari": "हीगित्तु",
        "latin": "hīgittu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l3",
      "stanza": 6,
      "text": "ಊಟದ ಆಟವು",
      "translations": {
        "en": "The meal game",
        "hi": "भोजन का खेल"
      },
      "transliterations": {
        "devanagari": "ऊटद आटवु",
        "latin": "ūṭada āṭavu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l4",
      "stanza": 6,
      "text": "ಮುಗಿದಿತ್ತು",
      "translations": {
