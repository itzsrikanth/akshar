  "segments": [
    {
      "id": "intro-1",
      "section": "intro",
      "text": "ಅ) ಚಿತ್ರಕ್ಕೆ (ಕೇಸರಿ ಮತ್ತು ಹಸಿರು) ಬಣ್ಣ ಹಾಕಲು ಹೇಳಿ.",
      "translations": {
        "en": "A) Tell them to colour the picture (saffron and green).",
        "hi": "अ) चित्र में (केसरी और हरा) रंग भरने को कहें।"
      },
      "transliterations": {
        "devanagari": "अ) चित्रक्कॆ (केसरि मत्तु हसिरु) बण्ण हाकलु हेळि.",
        "latin": "a) citrakkè (kesari mattu hasiru) baṇṇa hākalu heḻi."
      },
      "type": "prose"
    },
    {
      "id": "intro-kesari",
      "section": "intro",
      "text": "ಕೇಸರಿ",
      "translations": {
        "en": "saffron/orange",
        "hi": "केसरी"
      },
      "transliterations": {
        "devanagari": "केसरि",
        "latin": "kesari"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "intro-hasiru",
      "section": "intro",
      "text": "ಹಸಿರು",
      "translations": {
        "en": "green",
        "hi": "हरा"
      },
      "transliterations": {
        "devanagari": "हसिरु",
        "latin": "hasiru"
      },
      "type": "vocabulary_term"
    },
    {
      "id": "intro-2",
      "section": "intro",
      "text": "ಆ) ಮಕ್ಕಳಿಗೆ ಇಷ್ಟವಾದ ಬಣ್ಣದಿಂದ ಚಿತ್ರ ತುಂಬಿಸಲು ಹೇಳಿ.",
      "translations": {
        "en": "B) Tell the children to fill the picture with a colour they like.",
        "hi": "आ) बच्चों से पसंद के रंग से चित्र भरवाएँ।"
      },
      "transliterations": {
        "devanagari": "आ) मक्कळिगॆ इष्टवाद बण्णदिंद चित्र तुंबिसलु हेळि.",
        "latin": "ā) makkaḻigè iṣṭavāda baṇṇadiṃda citra tuṃbisalu heḻi."
      },
      "type": "prose"
    },
    {
      "id": "poem-intro",
      "section": "poem",
      "text": "(ಪದ್ಯವನ್ನು ಹಾಡಿ, ಮಕ್ಕಳಿಂದ ಹಾಡಿಸಿ)",
      "translations": {
        "en": "(Sing the poem and have the children sing)",
        "hi": "(पद्य गाएँ, बच्चों से गवाएँ)"
      },
      "transliterations": {
        "devanagari": "(पद्यवन्नु हाडि, मक्कळिंद हाडिसि)",
        "latin": "(padyavannu hāḍi, makkaḻiṃda hāḍisi)"
      },
      "type": "prose"
    },
    {
      "id": "poem-s1l1",
      "stanza": 1,
      "text": "ಬೇಸಿಗೆ ರಜೆಯಲಿ",
      "translations": {
        "en": "In the summer holiday",
        "hi": "ग्रीष्म अवकाश में"
      },
      "transliterations": {
        "devanagari": "बेसिगॆ रजॆयलि",
        "latin": "besigè rajèyali"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "stanza": 1,
      "text": "ಅಪ್ಪನ ಜೊತೆ ನಾ",
      "translations": {
        "en": "With father I",
        "hi": "पिता के साथ मैं"
      },
      "transliterations": {
        "devanagari": "अप्पन जॊतॆ ना",
        "latin": "appana jòtè nā"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l3",
      "stanza": 1,
      "text": "ಹಳ್ಳಿಗೆ ಹೋಗುವೆನು",
      "translations": {
        "en": "Will go to the village",
        "hi": "गाँव जाऊँगा"
      },
      "transliterations": {
        "devanagari": "हळ्ळिगॆ होगुवॆनु",
        "latin": "haḻḻigè hoguvènu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "stanza": 2,
      "text": "ಬೆವರನು ಸುರಿಸುವ",
      "translations": {
        "en": "Sweating",
        "hi": "पसीना बहाते"
      },
      "transliterations": {
        "devanagari": "बॆवरनु सुरिसुव",
        "latin": "bèvaranu surisuva"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "stanza": 2,
      "text": "ರೈತರ ಜೊತೆಯಲಿ",
      "translations": {
        "en": "With the farmers",
        "hi": "किसानों के साथ"
      },
      "transliterations": {
        "devanagari": "रैतर जॊतॆयलि",
        "latin": "raitara jòtèyali"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l3",
      "stanza": 2,
      "text": "ನಾನೂ ದುಡಿಯುವೆನು",
      "translations": {
        "en": "I too will work",
        "hi": "मैं भी मेहनत करूँगा"
      },
      "transliterations": {
        "devanagari": "नानू दुडियुवॆनु",
        "latin": "nānū duḍiyuvènu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "stanza": 3,
      "text": "ಮುಗಿಲನೆ ಮುಟ್ಟುವ",
      "translations": {
        "en": "Touching the sky",
        "hi": "आकाश छूती"
      },
      "transliterations": {
        "devanagari": "मुगिलनॆ मुट्टुव",
        "latin": "mugilanè muṭṭuva"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "stanza": 3,
      "text": "ಎತ್ತರ ದನಿಯಲಿ",
      "translations": {
        "en": "In a loud voice",
        "hi": "ऊँची आवाज़ में"
      },
      "transliterations": {
        "devanagari": "ऎत्तर दनियलि",
        "latin": "èttara daniyali"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l3",
      "stanza": 3,
      "text": "ಹಾಡನು ಹೇಳುವೆನು",
      "translations": {
        "en": "I will sing a song",
        "hi": "गीत गाऊँगा"
      },
      "transliterations": {
        "devanagari": "हाडनु हेळुवॆनु",
        "latin": "hāḍanu heḻuvènu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l1",
      "stanza": 4,
      "text": "ಜಗದಲಿ ನಡೆದಿಹ",
      "translations": {
        "en": "Happening in the world",
        "hi": "जगत में घटी"
      },
      "transliterations": {
        "devanagari": "जगदलि नडॆदिह",
        "latin": "jagadali naḍèdiha"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l2",
      "stanza": 4,
      "text": "ಕೌತುಕ ವಿಷಯವ",
      "translations": {
        "en": "Wonderful matters",
        "hi": "अद्भुत बातें"
      },
      "transliterations": {
        "devanagari": "कौतुक विषयव",
        "latin": "kautuka viṣayava"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s4l3",
      "stanza": 4,
      "text": "ಅವರಿಗೆ ತಿಳಿಸುವೆನು",
      "translations": {
        "en": "I will tell them",
        "hi": "उन्हें बताऊँगा"
      },
      "transliterations": {
        "devanagari": "अवरिगॆ तिळिसुवॆनु",
        "latin": "avarigè tiḻisuvènu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l1",
      "stanza": 5,
      "text": "ತೋಟದಿ ಬೆಳೆದಿಹ",
      "translations": {
        "en": "Grown in the garden",
        "hi": "बगीचे में उगे"
      },
      "transliterations": {
        "devanagari": "तोटदि बॆळॆदिह",
        "latin": "toṭadi bèḻèdiha"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l2",
      "stanza": 5,
      "text": "ಬಗೆ ಬಗೆ ಹಣ್ಣಿನ",
      "translations": {
        "en": "Of many kinds of fruit",
        "hi": "कई तरह के फलों का"
      },
      "transliterations": {
        "devanagari": "बगॆ बगॆ हण्णिन",
        "latin": "bagè bagè haṇṇina"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s5l3",
      "stanza": 5,
      "text": "ಸವಿಯನು ಸವಿಯುವೆನು",
      "translations": {
        "en": "I will taste the flavour",
        "hi": "स्वाद लूँगा"
      },
      "transliterations": {
        "devanagari": "सवियनु सवियुवॆनु",
        "latin": "saviyanu saviyuvènu"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l1",
      "stanza": 6,
      "text": "ಹಚ್ಚನೆ ಹಸುರಿನ",
      "translations": {
        "en": "Of deep green",
        "hi": "गहरी हरियाली की"
      },
      "transliterations": {
        "devanagari": "हच्चनॆ हसुरिन",
        "latin": "haccanè hasurina"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l2",
      "stanza": 6,
      "text": "ಸುಂದರ ಸೃಷ್ಟಿಯ",
      "translations": {
        "en": "Of beautiful creation",
        "hi": "सुंदर सृष्टि की"
      },
      "transliterations": {
        "devanagari": "सुंदर सृष्टिय",
        "latin": "suṃdara sṛṣṭiya"
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s6l3",
      "stanza": 6,
      "text": "ಸೊಬಗನು ಕಾಣುವೆನು!",
      "translations": {
        "en": "I will see the beauty!",
        "hi": "शोभा देखूँगा!"
      },
      "transliterations": {
        "devanagari": "सॊबगनु काणुवॆनु!",
        "latin": "sòbaganu kāṇuvènu!"
      },
      "type": "poem_line"
    },
