        "latin": "\"\""
      },
      "type": "prose"
    },
    {
      "id": "poem-s1l1",
      "stanza": 1,
      "text": "ನವಮಾಸ ಹೊತ್ತು",
      "translations": {
        "en": "\"\"",
        "hi": "\"\""
      },
      "transliterations": {
        "devanagari": "\"\"",
        "latin": "\"\""
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l2",
      "stanza": 1,
      "text": "ನನ್ನನು ಹೆತ್ತು",
      "translations": {
        "en": "\"\"",
        "hi": "\"\""
      },
      "transliterations": {
        "devanagari": "\"\"",
        "latin": "\"\""
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s1l3",
      "stanza": 1,
      "text": "ಸಾಕಿದ ತಾಯಿಗೆ ವಂದನೆ",
      "translations": {
        "en": "\"\"",
        "hi": "\"\""
      },
      "transliterations": {
        "devanagari": "\"\"",
        "latin": "\"\""
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l1",
      "stanza": 2,
      "text": "ಮೈಮುರಿ ದುಡಿದು",
      "translations": {
        "en": "\"\"",
        "hi": "\"\""
      },
      "transliterations": {
        "devanagari": "\"\"",
        "latin": "\"\""
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l2",
      "stanza": 2,
      "text": "ನನ್ನನು ಸಲುಹಿ",
      "translations": {
        "en": "\"\"",
        "hi": "\"\""
      },
      "transliterations": {
        "devanagari": "\"\"",
        "latin": "\"\""
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s2l3",
      "stanza": 2,
      "text": "ಬೆಳೆಸಿದ ತಂದೆಗೆ ವಂದನೆ",
      "translations": {
        "en": "\"\"",
        "hi": "\"\""
      },
      "transliterations": {
        "devanagari": "\"\"",
        "latin": "\"\""
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l1",
      "stanza": 3,
      "text": "ವಿದ್ಯಾ ಬುದ್ಧಿ",
      "translations": {
        "en": "\"\"",
        "hi": "\"\""
      },
      "transliterations": {
        "devanagari": "\"\"",
        "latin": "\"\""
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l2",
      "stanza": 3,
      "text": "ಬಾಲ್ಯದಿ ಕಲಿಸಿ",
      "translations": {
        "en": "\"\"",
        "hi": "\"\""
      },
      "transliterations": {
        "devanagari": "\"\"",
        "latin": "\"\""
      },
      "type": "poem_line"
    },
    {
      "id": "poem-s3l3",
      "stanza": 3,
      "text": "ಹರಸಿದ ಗುರುವಿಗೆ ವಂದನೆ",
