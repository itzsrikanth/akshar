  "segments": [
    {
      "id": "intro-1",
      "text": "ತೋಚಿದಂತೆ ಗೀಚು",
      "translations": {
        "en": "Scribble as you like",
        "hi": "जैसा सूझे वैसा घसीटें"
      },
      "transliterations": {
        "devanagari": "तोचिदंतॆ गीचु",
        "latin": "tocidaṃtè gīcu"
      },
      "type": "prose"
    },
    {
      "id": "intro-2",
      "text": "(ಮಕ್ಕಳು ತಮ್ಮ ಮನಸ್ಸಿಗೆ ಬಂದಂತೆ ಗೆರೆ ಎಳೆಯಲು ಹೇಳಿ)",
      "translations": {
        "en": "(Tell the children to draw lines as they wish)",
        "hi": "(बच्चों से मनचाहे रेखाएँ खींचने को कहें)"
      },
      "transliterations": {
        "devanagari": "(मक्कळु तम्म मनस्सिगॆ बंदंतॆ गॆरॆ ऎळॆयलु हेळि)",
        "latin": "(makkaḻu tamma manassigè baṃdaṃtè gèrè èḻèyalu heḻi)"
      },
      "type": "prose"
    },
