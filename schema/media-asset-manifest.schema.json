{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/itzsrikanth/akshar/schema/media-asset-manifest.schema.json",
  "title": "Akshar media asset manifest",
  "description": "Provider-independent mapping from chapter segment IDs to immutable pronunciation (or other) media objects. Object bytes live in external storage; this file is versioned in Git.",
  "type": "object",
  "required": ["meta", "assets"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "bookId",
        "editionId",
        "chapterId",
        "sourceLanguage",
        "voice",
        "sourceFile"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "const": 1
        },
        "bookId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "editionId": {
          "type": "string",
          "minLength": 1
        },
        "chapterId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "sourceLanguage": {
          "type": "string",
          "minLength": 2,
          "description": "Spoken language of the clips (e.g. kn). One clip serves transliterations of the same text."
        },
        "sourceFile": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path to the source YAML this manifest maps (must match meta.source in contributor files)."
        },
        "sourceContentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Optional SHA-256 of the normalized source file bytes used when generating clips."
        },
        "voice": {
          "type": "object",
          "required": ["id", "provider", "model", "version"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Stable voice identity included in object keys (e.g. bhashini-kn-female-v1)."
            },
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "description": "Rights for redistributing generated or recorded audio."
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "object",
      "description": "Keys are segment IDs copied character-for-character from the source file. Partial maps are valid.",
      "additionalProperties": {
        "$ref": "#/definitions/asset"
      }
    },
    "labels": {
      "type": "object",
      "description": "Optional non-segment media (unused in v1). Reserved for section-level audio.",
      "additionalProperties": {
        "$ref": "#/definitions/asset"
      }
    }
  },
  "definitions": {
    "asset": {
      "type": "object",
      "required": [
        "assetId",
        "objectKey",
        "contentType",
        "bytes",
        "sha256",
        "textDigest"
      ],
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 over normalized text + language + voice identity + synthesis settings. Equals object content identity when the clip is derived solely from that input."
        },
        "objectKey": {
          "type": "string",
          "pattern": "^audio/[a-z0-9-]+/[a-z0-9._-]+/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$",
          "description": "Immutable object key: audio/<lang>/<voice-id>/<hash-prefix>/<assetId>.<ext>"
        },
        "contentType": {
          "type": "string",
          "enum": ["audio/mp4", "audio/mpeg", "audio/ogg", "audio/wav"]
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the uploaded object bytes."
        },
        "textDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of normalized source segment text (NFC, trimmed)."
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "segmentType": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
