{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/itzsrikanth/akshar/schema/lexicon-forms.schema.json",
  "title": "Akshar lexicon forms",
  "type": "object",
  "required": ["forms"],
  "additionalProperties": false,
  "properties": {
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["form", "lemmaIds", "status"],
        "additionalProperties": false,
        "properties": {
          "form": { "type": "string", "minLength": 1 },
          "lemmaIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^lemma-[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "status": {
            "type": "string",
            "enum": ["exact", "reviewed-inflection", "ambiguous"]
          }
        }
      }
    }
  }
}
