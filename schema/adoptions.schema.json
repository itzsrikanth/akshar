{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/itzsrikanth/akshar/schema/adoptions.schema.json",
  "title": "Akshar adoption catalog",
  "type": "object",
  "required": ["adoptions"],
  "additionalProperties": false,
  "properties": {
    "adoptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "bookId", "editionId", "learnerGrade", "subjectLanguage", "languageRole"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "bookId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "editionId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "learnerGrade": { "type": "integer", "minimum": 1 },
          "subjectLanguage": { "type": "string", "minLength": 2 },
          "languageRole": {
            "type": "string",
            "enum": ["first-language", "second-language", "third-language"]
          },
          "schoolMedium": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "curriculum": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
