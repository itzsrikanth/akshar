EXPO_PUBLIC_MEDIA_HEALTH_URL=
# Optional public object origin (no trailing slash), e.g. https://pub-….r2.dev
EXPO_PUBLIC_MEDIA_BASE_URL=
# 1 = play bundled placeholder pronunciation for speakable reader lines (UI testing
# before real TTS). Defaults to 1 in __DEV__, 0 in production builds. EAS
# production/preview profiles force 0 via apps/mobile/eas.json — do not set 1 there.
EXPO_PUBLIC_MEDIA_SAMPLE_MODE=1
