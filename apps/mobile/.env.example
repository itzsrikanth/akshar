EXPO_PUBLIC_MEDIA_HEALTH_URL=
# Optional public object origin (no trailing slash), e.g. https://pub-….r2.dev
# Used for chapter-download prefetch and playback when local audio-v1 cache misses.
EXPO_PUBLIC_MEDIA_BASE_URL=
# 1 = enable speakable-line pronunciation (sample manifests / shared placeholder
# before real TTS). Prefers local audio-v1 cache, then MEDIA_BASE_URL, then the
# bundled beep. Defaults to 1 in __DEV__, 0 in production builds. EAS
# production/preview profiles force 0 via apps/mobile/eas.json — do not set 1 there.
EXPO_PUBLIC_MEDIA_SAMPLE_MODE=1
